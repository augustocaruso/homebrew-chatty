+type historyClient struct {
+	*WhatsAppClient
+	fetches  []bridgev2.FetchMessagesParams
+	fetchErr error
+}
+
+func (client *historyClient) FetchMessages(ctx context.Context, params bridgev2.FetchMessagesParams) (*bridgev2.FetchMessagesResponse, error) {
+	client.fetches = append(client.fetches, params)
+	response, err := client.WhatsAppClient.FetchMessages(ctx, params)
+	client.fetchErr = err
+	return response, err
+}

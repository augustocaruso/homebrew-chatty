+func TestCreateDMBufferedHistory(t *testing.T) {
+	for _, server := range []string{types.HiddenUserServer, types.DefaultUserServer} {
+		for _, buffer := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/buffer_%t", server, buffer), func(t *testing.T) {
+				client, mx := newHistoryClient(t)
+				jid := types.NewJID("100000000002", server)
+				if buffer {
+					seedHistory(t, client, jid, client.UserLogin.ID)
+				}
+				response := client.makeCreateChatResponse(context.Background(), jid, jid)
+				if response.PortalInfo.CanBackfill != buffer {
+					t.Fatalf("CanBackfill=%t, want %t for buffered conversation", response.PortalInfo.CanBackfill, buffer)
+				}
+				if buffer && (response.PortalInfo.Disappear == nil || response.PortalInfo.Disappear.Timer != time.Hour) {
+					t.Fatal("history disappearing setting not applied")
+				}
+				portal, err := client.Main.Bridge.GetPortalByKey(context.Background(), response.PortalKey)
+				if err != nil {
+					t.Fatal(err)
+				}
+				ctx := zerolog.New(t.Output()).WithContext(context.Background())
+				if err = portal.CreateMatrixRoom(ctx, client.UserLogin, response.PortalInfo); err != nil {
+					t.Fatal(err)
+				}
+				if client.fetchErr != nil {
+					t.Fatalf("initial fetch failed: %v", client.fetchErr)
+				}
+				if portal.MXID == "" {
+					t.Fatal("room was not created")
+				}
+				if !buffer {
+					if len(client.fetches) != 0 || len(mx.published) != 0 {
+						t.Fatal("unbuffered DM triggered backfill")
+					}
+					return
+				}
+				if len(client.fetches) != 1 {
+					t.Fatalf("fetch calls=%d, want 1", len(client.fetches))
+				}
+				fetch := client.fetches[0]
+				if !fetch.Forward || fetch.AnchorMessage != nil || fetch.Count != 2 {
+					t.Fatalf("not initial forward backfill: %+v", fetch)
+				}
+				if !slices.Equal(mx.published, []string{"synthetic message 2", "synthetic message 3"}) {
+					t.Fatalf("published=%v, want newest two in chronological order", mx.published)
+				}
+				stored, err := client.Main.Bridge.DB.Message.GetAllPartsByID(context.Background(), portal.Receiver, waid.MakeMessageID(jid, jid, "SYNTHETIC3"))
+				if err != nil || len(stored) != 1 {
+					t.Fatalf("message mapping not persisted: count=%d err=%v", len(stored), err)
+				}
+			})
+		}
+	}
+}

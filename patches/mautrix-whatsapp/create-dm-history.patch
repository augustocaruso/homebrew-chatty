+func newHistoryClient(t *testing.T) (*historyClient, *historyMatrix) {
+	t.Helper()
+	ctx := context.Background()
+	raw, err := sql.Open("sqlite3", "file::memory:?_foreign_keys=on")
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw.SetMaxOpenConns(1)
+	t.Cleanup(func() {
+		if err := raw.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	db, err := dbutil.NewWithDB(raw, "sqlite3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	main := &WhatsAppConnector{Config: Config{DisplaynameTemplate: "{{.PushName}}"}}
+	if err = main.Config.PostProcess(); err != nil {
+		t.Fatal(err)
+	}
+	mx := &historyMatrix{}
+	mx.bot = &historyIntent{matrix: mx, mxid: "@bot:example.invalid"}
+	cfg := &bridgeconfig.BridgeConfig{SplitPortals: true}
+	cfg.Backfill.Enabled = true
+	cfg.Backfill.MaxInitialMessages = 2
+	cfg.Backfill.MaxCatchupMessages = 1
+	bridge := bridgev2.NewBridge("synthetic", db, zerolog.Nop(), cfg, mx, &historyNetwork{main}, func(*bridgev2.Bridge) bridgev2.CommandProcessor { return nil })
+	bridge.BackgroundCtx = ctx
+	if err = bridge.DB.Upgrade(ctx); err != nil {
+		t.Fatal(err)
+	}
+	main.DB = wadb.New(bridge.ID, db, zerolog.Nop())
+	if err = main.DB.Upgrade(ctx); err != nil {
+		t.Fatal(err)
+	}
+	deviceStore := sqlstore.NewWithDB(raw, "sqlite3", waLog.Noop)
+	if err = deviceStore.Upgrade(ctx); err != nil {
+		t.Fatal(err)
+	}
+	device := deviceStore.NewDevice()
+	own := types.NewJID("15550000001", types.DefaultUserServer)
+	ownLID := types.NewJID("100000000001", types.HiddenUserServer)
+	device.ID = &own
+	device.LID = ownLID
+	device.SetAllStores(sqlstore.NewSQLStore(deviceStore, own))
+	device.LIDs = deviceStore.LIDMap
+	user := &database.User{MXID: "@owner:example.invalid"}
+	if err = bridge.DB.User.Insert(ctx, user); err != nil {
+		t.Fatal(err)
+	}
+	login := &bridgev2.UserLogin{UserLogin: &database.UserLogin{ID: "synthetic-login", UserMXID: user.MXID, Metadata: &waid.UserLoginMetadata{Blocklist: &types.Blocklist{}}}, Bridge: bridge, User: &bridgev2.User{User: user, Bridge: bridge}, Log: zerolog.Nop()}
+	if err = bridge.DB.UserLogin.Insert(ctx, login.UserLogin); err != nil {
+		t.Fatal(err)
+	}
+	main.MsgConv = msgconv.New(bridge)
+	main.MsgConv.DB = main.DB
+	wa := &WhatsAppClient{Main: main, UserLogin: login, JID: own, LID: ownLID, Device: device, Client: whatsmeow.NewClient(device, waLog.Noop), MC: noopMCInstance}
+	client := &historyClient{WhatsAppClient: wa}
+	login.Client = client
+	return client, mx
+}

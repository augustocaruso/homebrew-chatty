+func seedHistory(t *testing.T, client *historyClient, jid types.JID, login networkid.UserLoginID) {
+	t.Helper()
+	ctx := context.Background()
+	conv := &wadb.Conversation{UserLoginID: login, ChatJID: jid, LastMessageTimestamp: time.Unix(1700000003, 0), EphemeralExpiration: ptr.Ptr(uint32(3600)), MarkedAsUnread: ptr.Ptr(true)}
+	if err := client.Main.DB.Conversation.Put(ctx, conv); err != nil {
+		t.Fatal(err)
+	}
+	var messages []*wadb.HistorySyncMessageTuple
+	for index := 1; index <= 3; index++ {
+		messageID := fmt.Sprintf("SYNTHETIC%d", index)
+		timestamp := uint64(1700000000 + index)
+		message := &waHistorySync.HistorySyncMsg{Message: &waWeb.WebMessageInfo{Key: &waCommon.MessageKey{RemoteJID: proto.String(jid.String()), FromMe: proto.Bool(false), ID: proto.String(messageID)}, MessageTimestamp: &timestamp, Message: &waE2E.Message{Conversation: proto.String(fmt.Sprintf("synthetic message %d", index))}}}
+		data, err := proto.Marshal(message)
+		if err != nil {
+			t.Fatal(err)
+		}
+		messages = append(messages, &wadb.HistorySyncMessageTuple{Info: &types.MessageInfo{MessageSource: types.MessageSource{Chat: jid, Sender: jid}, ID: messageID, Timestamp: time.Unix(int64(timestamp), 0)}, Message: data})
+	}
+	if err := client.Main.DB.Message.Put(ctx, login, jid, messages); err != nil {
+		t.Fatal(err)
+	}
+}

+func TestCreateDMHistoryLoginIsolation(t *testing.T) {
+	client, _ := newHistoryClient(t)
+	ctx := context.Background()
+	jid := types.NewJID("100000000002", types.HiddenUserServer)
+	other := &database.UserLogin{ID: "other-login", UserMXID: client.UserLogin.UserMXID, Metadata: &waid.UserLoginMetadata{}}
+	if err := client.Main.Bridge.DB.UserLogin.Insert(ctx, other); err != nil {
+		t.Fatal(err)
+	}
+	seedHistory(t, client, jid, other.ID)
+	if client.makeCreateChatResponse(ctx, jid, jid).PortalInfo.CanBackfill {
+		t.Fatal("history from another login enabled backfill")
+	}
+}

+}
+func (intent *historyIntent) SendMessage(_ context.Context, _ id.RoomID, typ event.Type, content *event.Content, _ *bridgev2.MatrixSendExtra) (*mautrix.RespSendEvent, error) {
+	if typ == event.EventMessage {
+		intent.matrix.published = append(intent.matrix.published, content.Parsed.(*event.MessageEventContent).Body)
+	}
+	return &mautrix.RespSendEvent{EventID: id.EventID(fmt.Sprintf("$synthetic%d", len(intent.matrix.published)))}, nil
+}

+func TestCreateChatPublicPathsBufferedHistory(t *testing.T) {
+	for _, path := range []string{"ghost_lid", "ghost_pn", "resolve_lid"} {
+		for _, buffer := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/buffer_%t", path, buffer), func(t *testing.T) {
+				ctx := context.Background()
+				client, _ := newHistoryClient(t)
+				jid := types.NewJID("100000000002", types.HiddenUserServer)
+				if buffer {
+					seedHistory(t, client, jid, client.UserLogin.ID)
+				}
+				var response *bridgev2.CreateChatResponse
+				var err error
+				if path == "resolve_lid" {
+					var resolved *bridgev2.ResolveIdentifierResponse
+					resolved, err = client.ResolveIdentifier(ctx, jid.String(), true)
+					if err == nil {
+						response = resolved.Chat
+					}
+				} else {
+					origJID := jid
+					if path == "ghost_pn" {
+						origJID = types.NewJID("15550000002", types.DefaultUserServer)
+						if err = client.Device.LIDs.PutLIDMapping(ctx, jid, origJID); err != nil {
+							t.Fatal(err)
+						}
+					}
+					response, err = client.CreateChatWithGhost(ctx, &bridgev2.Ghost{Ghost: &database.Ghost{ID: waid.MakeUserID(origJID)}})
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				if response == nil || response.PortalInfo == nil || response.PortalInfo.CanBackfill != buffer {
+					t.Fatalf("%s did not preserve buffered-history eligibility (%t)", path, buffer)
+				}
+				if response.PortalKey != client.makeWAPortalKey(jid) {
+					t.Fatalf("portal key=%v, want canonical LID", response.PortalKey)
+				}
+				if path == "ghost_pn" && response.DMRedirectedTo != waid.MakeUserID(jid) {
+					t.Fatal("PN ghost did not redirect to canonical LID")
+				}
+			})
+		}
+	}
+}

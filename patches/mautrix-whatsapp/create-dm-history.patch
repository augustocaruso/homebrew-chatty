+func (mx *historyMatrix) BotIntent() bridgev2.MatrixAPI { return mx.bot }
+func (mx *historyMatrix) GhostIntent(user networkid.UserID) bridgev2.MatrixAPI {
+	return &historyIntent{matrix: mx, mxid: mx.FormatGhostMXID(user)}
+}
+func (mx *historyMatrix) FormatGhostMXID(user networkid.UserID) id.UserID {

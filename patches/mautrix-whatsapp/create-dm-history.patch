+// Only external Matrix I/O is replaced. The connector, SQL stores, room creation,
+// forward-backfill selection, conversion and message persistence are real.
+type historyMatrix struct {
+	bridgev2.MatrixConnector
+	bot       *historyIntent
+	published []string
+}
+type historyIntent struct {
+	bridgev2.MatrixAPI
+	matrix *historyMatrix
+	mxid   id.UserID
+}

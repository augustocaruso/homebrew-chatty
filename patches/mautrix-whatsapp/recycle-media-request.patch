@@ -0,0 +1,61 @@
+package connector
+
+import (
+	"context"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+	"github.com/rs/zerolog"
+	"go.mau.fi/util/dbutil"
+	"go.mau.fi/whatsmeow/types"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/database"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+	"maunium.net/go/mautrix/event"
+
+	"go.mau.fi/mautrix-whatsapp/pkg/connector/wadb"
+	"go.mau.fi/mautrix-whatsapp/pkg/waid"
+)
+
+func TestRecycleReactionRequestsMediaWithoutSendingReaction(t *testing.T) {
+	for _, emoji := range []string{"♻", "♻️"} {
+		t.Run(emoji, func(t *testing.T) {
+			ctx := context.Background()
+			db, err := dbutil.NewWithDialect(":memory:", "sqlite3")
+			if err != nil {
+				t.Fatal(err)
+			}
+			db.RawDB.SetMaxOpenConns(1)
+			t.Cleanup(func() { _ = db.Close() })
+			bridgeDB := database.New("synthetic", database.MetaTypes{}, db)
+			if err = bridgeDB.Upgrade(ctx); err != nil {
+				t.Fatal(err)
+			}
+			waDB := wadb.New("synthetic", db, zerolog.Nop())
+			if err = waDB.Upgrade(ctx); err != nil {
+				t.Fatal(err)
+			}
+			messageID := waid.MakeMessageID(types.NewJID("100", types.DefaultUserServer), types.NewJID("200", types.DefaultUserServer), "SYNTHETIC")
+			request := &wadb.MediaRequest{UserLoginID: "owner", MessageID: messageID, PortalKey: networkid.PortalKey{ID: "100@s.whatsapp.net", Receiver: "owner"}, Status: wadb.MediaBackfillRequestStatusRequestFailed, Error: "previous failure"}
+			if err = waDB.MediaRequest.Put(ctx, request); err != nil {
+				t.Fatal(err)
+			}
+			client := &WhatsAppClient{Main: &WhatsAppConnector{DB: waDB, Bridge: &bridgev2.Bridge{DB: bridgeDB}}, UserLogin: &bridgev2.UserLogin{UserLogin: &database.UserLogin{ID: "owner"}}}
+			result, err := client.HandleMatrixReaction(ctx, &bridgev2.MatrixReaction{MatrixEventBase: bridgev2.MatrixEventBase[*event.ReactionEventContent]{Portal: &bridgev2.Portal{Portal: &database.Portal{PortalKey: networkid.PortalKey{ID: "synthetic.bad@s.whatsapp.net"}}}}, TargetMessage: &database.Message{ID: messageID}, PreHandleResp: &bridgev2.MatrixReactionPreResponse{Emoji: emoji}})
+			if err != nil || result == nil {
+				t.Fatalf("media request reaction: result=%v error=%v", result, err)
+			}
+			updated, err := waDB.MediaRequest.GetByMessageID(ctx, "owner", messageID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if updated.Status != wadb.MediaBackfillRequestStatusRequestSkipped || updated.Error != "" {
+				t.Fatalf("media request was not retried safely for missing target: %#v", updated)
+			}
+			other, err := waDB.MediaRequest.GetByMessageID(ctx, "another-owner", messageID)
+			if err != nil || other != nil {
+				t.Fatalf("cross-login request leaked: %v %v", other, err)
+			}
+		})
+	}
+}

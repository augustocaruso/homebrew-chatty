@@ -0,0 +1,49 @@
+package msgconv
+
+import "testing"
+
+func TestStripLeadingWhatsAppGhostMention(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		expected string
+		stripped bool
+	}{
+		{
+			name:     "strips leading whatsapp ghost mention",
+			input:    "@whatsapp_15550100:example.org: synthetic message",
+			expected: "synthetic message",
+			stripped: true,
+		},
+		{
+			name:     "strips leading whatsapp ghost mention without space",
+			input:    "@whatsapp_15550100:example.org:synthetic",
+			expected: "synthetic",
+			stripped: true,
+		},
+		{
+			name:     "keeps normal matrix mention",
+			input:    "@alice:example.org: synthetic message",
+			expected: "@alice:example.org: synthetic message",
+			stripped: false,
+		},
+		{
+			name:     "keeps whatsapp mention in middle",
+			input:    "synthetic message @whatsapp_15550100:example.org:",
+			expected: "synthetic message @whatsapp_15550100:example.org:",
+			stripped: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, stripped := stripLeadingWhatsAppGhostMention(tt.input)
+			if got != tt.expected {
+				t.Fatalf("got %q, expected %q", got, tt.expected)
+			}
+			if stripped != tt.stripped {
+				t.Fatalf("got stripped=%v, expected %v", stripped, tt.stripped)
+			}
+		})
+	}
+}

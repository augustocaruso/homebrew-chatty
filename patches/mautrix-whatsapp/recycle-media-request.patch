+package msgconv
+
+import "strings"
+
+func stripLeadingWhatsAppGhostMention(text string) (string, bool) {
+	if !strings.HasPrefix(text, "@whatsapp_") {
+		return text, false
+	}
+
+	firstColon := strings.IndexByte(text, ':')
+	if firstColon < 0 {
+		return text, false
+	}
+
+	rest := text[firstColon+1:]
+	secondColon := strings.IndexByte(rest, ':')
+	if secondColon < 0 {
+		return text, false
+	}
+
+	stripped := strings.TrimLeft(rest[secondColon+1:], " \t\r\n")
+	if stripped == "" {
+		return text, false
+	}
+
+	return stripped, true
+}

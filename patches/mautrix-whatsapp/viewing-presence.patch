+			portal.Receiver = "another-login"
+		}
+		if err := bridge.DB.Portal.Insert(ctx, portal); err != nil {
+			t.Fatal(err)
+		}
+		if room != "foreign" {
+			if err := bridge.DB.UserPortal.Put(ctx, database.UserPortalFor(wa.UserLogin.UserLogin, portal.PortalKey)); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	server := httptest.NewServer(mx.AS.Router)
+	t.Cleanup(server.Close)
+	return &viewingHTTPFixture{client: wa, owner: owner, clock: clock, sent: sent, server: server, logs: logs}
+}
+
+func (fixture *viewingHTTPFixture) request(t *testing.T, method, token, user, login, body string) (int, []byte) {
+	t.Helper()
+	request, err := http.NewRequest(method, fixture.server.URL+"/_matrix/provision/v3/chatty/viewing/"+login+"?user_id="+user, strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if token != "" {
+		request.Header.Set("Authorization", "Bearer "+token)
+	}
+	request.Header.Set("Content-Type", "application/json")
+	response, err := fixture.server.Client().Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	data, err := io.ReadAll(response.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return response.StatusCode, data
+}
+
+func TestViewingHTTPRejections(t *testing.T) {
+	for _, test := range []struct {
+		name, token, user, login, body string
+		status                         int
+	}{
+		{"missing token", "", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!owned:example.invalid"}`, 401},
+		{"invalid token", "synthetic-invalid", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!owned:example.invalid"}`, 401},
+		{"forged user", "synthetic-mac", "@other:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!owned:example.invalid"}`, 401},
+		{"foreign login", "synthetic-other", "@other:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!owned:example.invalid"}`, 403},
+		{"unknown login", "synthetic-mac", "@owner:example.invalid", "missing", `{"generation":"1","room_id":"!owned:example.invalid"}`, 403},
+		{"no device", "synthetic-no-device", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!owned:example.invalid"}`, 401},
+		{"shared secret", "synthetic-shared-secret", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!owned:example.invalid"}`, 401},
+		{"unknown room", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!missing:example.invalid"}`, 403},
+		{"foreign portal", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!foreign:example.invalid"}`, 403},
+		{"wrong receiver", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!wrong-receiver:example.invalid"}`, 403},
+		{"not joined", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!not-joined:example.invalid"}`, 403},
+		{"forged device", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!owned:example.invalid","device_id":"PHONE"}`, 400},
+		{"zero generation", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"0","room_id":"!owned:example.invalid"}`, 400},
+		{"missing generation", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"room_id":"!owned:example.invalid"}`, 400},
+		{"overflow generation", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"18446744073709551616","room_id":"!owned:example.invalid"}`, 400},
+		{"numeric generation", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":1,"room_id":"!owned:example.invalid"}`, 400},
+		{"both states", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"1","room_id":"!owned:example.invalid","left":true}`, 400},
+		{"neither state", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"1"}`, 400},
+		{"invalid JSON", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{`, 400},
+		{"trailing JSON", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"1","left":true} {}`, 400},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			fixture := newViewingHTTPFixture(t)
+			before, err := fixture.client.Main.Bridge.DB.Portal.GetAll(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			status, data := fixture.request(t, "POST", test.token, test.user, test.login, test.body)
+			if status != test.status {
+				t.Fatalf("status=%d want=%d body=%s", status, test.status, data)
+			}
+			after, err := fixture.client.Main.Bridge.DB.Portal.GetAll(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(*fixture.sent) != 0 || fixture.owner.generation(viewingMac) != 0 || len(before) != len(after) {
+				t.Fatal("rejected request mutated presence/leases/portals")
+			}
+			if strings.Contains(fixture.logs.String(), test.token) && test.token != "" {
+				t.Fatal("token leaked into bridge logs")
+			}
+			if strings.Contains(fixture.logs.String(), "!owned:example.invalid") {
+				t.Fatal("room body leaked into bridge logs")
+			}
+		})
+	}
+}
+
+func TestViewingHTTPCapabilityUnionAndErrors(t *testing.T) {
+	fixture := newViewingHTTPFixture(t)
+	status, data := fixture.request(t, "GET", "synthetic-mac", "@owner:example.invalid", "synthetic-login", "")
+	var capability viewingResponse
+	if err := json.Unmarshal(data, &capability); err != nil {
+		t.Fatal(err)
+	}
+	if status != 200 || capability.Version != 1 || capability.LeaseSeconds != 15 || capability.RenewSeconds != 5 || capability.Generation != 0 {
+		t.Fatalf("capability: %d %s", status, data)
+	}
+	for _, call := range []struct{ token, body string }{
+		{"synthetic-mac", `{"generation":"1","room_id":"!owned:example.invalid"}`},
+		{"synthetic-phone", `{"generation":"1","left":true}`},
+		{"synthetic-mac", `{"generation":"1","left":true}`},
+	} {
+		status, data = fixture.request(t, "POST", call.token, "@owner:example.invalid", "synthetic-login", call.body)
+		if status != 200 {
+			t.Fatalf("status=%d %s", status, data)
+		}
+	}
+	if !reflect.DeepEqual(*fixture.sent, []types.Presence{types.PresenceAvailable}) {
+		t.Fatalf("device union failed: %v", *fixture.sent)
+	}
+	status, data = fixture.request(t, "GET", "synthetic-mac", "@owner:example.invalid", "synthetic-login", "")
+	if err := json.Unmarshal(data, &capability); err != nil {
+		t.Fatal(err)
+	}
+	if status != 200 || capability.Generation != 1 {
+		t.Fatal("capability did not return device high-water mark")
+	}
+	fixture.owner.send = func(context.Context, types.Presence) error { return errors.New("synthetic external secret") }
+	status, data = fixture.request(t, "POST", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"2","left":true}`)
+	if status != 502 || !strings.Contains(string(data), "FI.MAU.PRESENCE_FAILED") || strings.Contains(string(data), "synthetic external secret") {
+		t.Fatalf("error not propagated/sanitized: %d %s", status, data)
+	}
+}
+
+func TestViewingHTTPDuplicateDoesNotRenew(t *testing.T) {
+	fixture := newViewingHTTPFixture(t)
+	for index := 0; index < 3; index++ {
+		status, data := fixture.request(t, "POST", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"9","room_id":"!owned:example.invalid"}`)
+		if status != 200 {
+			t.Fatalf("%d %s", status, data)
+		}
+		fixture.clock.advance(viewingRenewInterval)
+	}
+	if !reflect.DeepEqual(*fixture.sent, []types.Presence{types.PresenceAvailable, types.PresenceUnavailable}) {
+		t.Fatalf("HTTP duplicate extended TTL: %v", *fixture.sent)
+	}
+	status, data := fixture.request(t, "POST", "synthetic-mac", "@owner:example.invalid", "synthetic-login", `{"generation":"8","room_id":"!owned:example.invalid"}`)
+	if status != 200 {
+		t.Fatalf("%d %s", status, data)
+	}
+	if len(*fixture.sent) != 2 {
+		t.Fatal("reordered request revived expired contribution")
+	}
+	t.Logf("HTTP surface: capability, focus, two-device union, duplicate/reordered expiry and 502 exercised on %s", fmt.Sprintf("local synthetic server"))
+}

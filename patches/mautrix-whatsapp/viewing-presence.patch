+package connector
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/id"
+)
+
+func TestViewingPresenceError(t *testing.T) {
+	client, _ := newHistoryClient(t)
+	t.Cleanup(func() { client.viewingOwner().stop() })
+	err := client.HandleMatrixViewingChat(context.Background(), &bridgev2.MatrixViewingChat{})
+	if err == nil {
+		t.Fatal("presence send failure must reach the caller")
+	}
+}
+
+type viewingTestTimer struct {
+	clock    *viewingTestClock
+	at       time.Time
+	callback func()
+	stopped  bool
+}
+
+func (timer *viewingTestTimer) Stop() bool {
+	timer.clock.mu.Lock()
+	defer timer.clock.mu.Unlock()
+	wasActive := !timer.stopped
+	timer.stopped = true
+	return wasActive
+}
+
+type viewingTestClock struct {
+	mu      sync.Mutex
+	current time.Time
+	timers  []*viewingTestTimer
+}
+
+func (clock *viewingTestClock) now() time.Time {
+	clock.mu.Lock()
+	defer clock.mu.Unlock()
+	return clock.current
+}
+func (clock *viewingTestClock) after(delay time.Duration, callback func()) viewingTimer {
+	clock.mu.Lock()
+	defer clock.mu.Unlock()
+	timer := &viewingTestTimer{clock: clock, at: clock.current.Add(delay), callback: callback}
+	clock.timers = append(clock.timers, timer)
+	return timer
+}
+func (clock *viewingTestClock) advance(delay time.Duration) {
+	clock.mu.Lock()
+	clock.current = clock.current.Add(delay)
+	clock.mu.Unlock()
+	for {
+		clock.mu.Lock()
+		var due *viewingTestTimer
+		for _, timer := range clock.timers {
+			if !timer.stopped && !clock.current.Before(timer.at) {
+				due = timer
+				timer.stopped = true
+				break
+			}
+		}
+		clock.mu.Unlock()
+		if due == nil {
+			return
+		}
+		due.callback()
+	}
+}
+
+func newViewingTestOwner(t *testing.T) (*viewingPresence, *viewingTestClock, *[]types.Presence) {
+	t.Helper()
+	clock := &viewingTestClock{current: time.Now()}
+	var sent []types.Presence
+	owner := newViewingPresence(context.Background(), func(_ context.Context, presence types.Presence) error {
+		sent = append(sent, presence)
+		return nil
+	}, func() {})
+	owner.now, owner.afterFunc = clock.now, clock.after
+	t.Cleanup(owner.stop)
+	return owner, clock, &sent
+}
+
+var viewingMac = viewingDevice{user: "@owner:example.invalid", device: "MAC"}
+var viewingPhone = viewingDevice{user: "@owner:example.invalid", device: "PHONE"}
+
+func applyViewing(t *testing.T, owner *viewingPresence, device viewingDevice, generation uint64, room string, wantAccepted bool) {
+	t.Helper()
+	accepted, err := owner.apply(context.Background(), device, generation, id.RoomID(room))
+	if err != nil || accepted != wantAccepted {
+		t.Fatalf("apply generation %d: accepted=%v err=%v", generation, accepted, err)
+	}
+}
+
+func TestViewingUnionAndExactExpiry(t *testing.T) {
+	owner, clock, sent := newViewingTestOwner(t)
+	applyViewing(t, owner, viewingMac, 1, "!mac:example.invalid", true)
+	applyViewing(t, owner, viewingPhone, 1, "", true)
+	if !reflect.DeepEqual(*sent, []types.Presence{types.PresenceAvailable}) {
+		t.Fatalf("phone left changed Mac presence: %v", *sent)
+	}
+	clock.advance(5 * time.Second)
+	applyViewing(t, owner, viewingPhone, 2, "!phone:example.invalid", true)
+	clock.advance(10 * time.Second)
+	if len(*sent) != 1 {
+		t.Fatalf("first expiry removed second device: %v", *sent)
+	}
+	clock.advance(5*time.Second - time.Nanosecond)
+	if len(*sent) != 1 {
+		t.Fatal("lease expired before exact limit")
+	}
+	clock.advance(time.Nanosecond)
+	if !reflect.DeepEqual(*sent, []types.Presence{types.PresenceAvailable, types.PresenceUnavailable}) {
+		t.Fatalf("last expiry did not go offline: %v", *sent)
+	}
+}
+
+func TestViewingGenerationReplayAndStaleTimers(t *testing.T) {
+	owner, clock, sent := newViewingTestOwner(t)
+	applyViewing(t, owner, viewingMac, 3, "!a:example.invalid", true)
+	stale := clock.timers[0].callback
+	clock.advance(5 * time.Second)
+	applyViewing(t, owner, viewingMac, 4, "!b:example.invalid", true)
+	applyViewing(t, owner, viewingMac, 3, "", false)
+	stale()
+	clock.advance(10 * time.Second)
+	applyViewing(t, owner, viewingMac, 4, "!b:example.invalid", false)
+	clock.advance(5 * time.Second)
+	if len(*sent) != 2 || (*sent)[1] != types.PresenceUnavailable {
+		t.Fatalf("duplicate extended expiry: %v", *sent)
+	}
+	applyViewing(t, owner, viewingMac, 4, "!b:example.invalid", false)
+	applyViewing(t, owner, viewingMac, 2, "!a:example.invalid", false)
+	if len(*sent) != 2 {
+		t.Fatal("replay revived expired lease")
+	}
+	applyViewing(t, owner, viewingMac, 5, "!a:example.invalid", true)
+	applyViewing(t, owner, viewingMac, 6, "", true)
+	applyViewing(t, owner, viewingMac, 5, "!a:example.invalid", false)
+	if len(*sent) != 4 || (*sent)[3] != types.PresenceUnavailable {
+		t.Fatalf("left replay revived lease: %v", *sent)
+	}
+}
+
+func TestViewingRenewalAndIndependentLeft(t *testing.T) {
+	owner, clock, sent := newViewingTestOwner(t)
+	applyViewing(t, owner, viewingMac, 1, "!a:example.invalid", true)
+	applyViewing(t, owner, viewingPhone, 1, "!b:example.invalid", true)
+	clock.advance(5 * time.Second)
+	applyViewing(t, owner, viewingMac, 2, "!a:example.invalid", true)
+	applyViewing(t, owner, viewingPhone, 2, "", true)
+	clock.advance(10 * time.Second)
+	if len(*sent) != 1 {
+		t.Fatalf("renewal not honored or other device left won: %v", *sent)
+	}
+	applyViewing(t, owner, viewingMac, 3, "", true)
+	if len(*sent) != 2 || (*sent)[1] != types.PresenceUnavailable {
+		t.Fatalf("last left did not go offline: %v", *sent)
+	}
+}
+
+func TestViewingReconnectAndPushNameReapply(t *testing.T) {
+	client, _ := newHistoryClient(t)
+	owner, clock, sent := newViewingTestOwner(t)
+	client.viewingOnce.Do(func() { client.viewing = owner })
+	applyViewing(t, owner, viewingMac, 1, "!a:example.invalid", true)
+	// Connected, PushNameSetting e AppStateSyncComplete usam este seam real.
+	if err := client.updatePresence(context.Background(), types.PresenceUnavailable); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(*sent, []types.Presence{types.PresenceAvailable, types.PresenceUnavailable, types.PresenceAvailable}) {
+		t.Fatalf("valid lease not reapplied: %v", *sent)
+	}
+	clock.advance(viewingLeaseTTL)
+	if err := client.updatePresence(context.Background(), types.PresenceUnavailable); err != nil {
+		t.Fatal(err)
+	}
+	if (*sent)[len(*sent)-1] != types.PresenceUnavailable {
+		t.Fatal("expired lease reapplied after reconnect")
+	}
+}
+
+func TestViewingSendFailuresRetryWithoutExtending(t *testing.T) {
+	owner, clock, sent := newViewingTestOwner(t)
+	failure := errors.New("synthetic send failure")
+	succeed := owner.send
+	owner.send = func(context.Context, types.Presence) error { return failure }
+	accepted, err := owner.apply(context.Background(), viewingMac, 1, "!a:example.invalid")
+	if !accepted || !errors.Is(err, failure) {
+		t.Fatalf("failure lost: %v", err)
+	}
+	if owner.confirmed != "" {
+		t.Fatal("failed presence marked confirmed")
+	}
+	owner.send = succeed
+	clock.advance(time.Second)
+	if len(*sent) != 1 || (*sent)[0] != types.PresenceAvailable {
+		t.Fatal("failed available not retried")
+	}
+	owner.send = func(context.Context, types.Presence) error { return failure }
+	clock.advance(14 * time.Second)
+	if owner.confirmed != "" {
+		t.Fatal("failed offline marked confirmed")
+	}
+	owner.send = succeed
+	clock.advance(time.Second)
+	if len(*sent) != 2 || (*sent)[1] != types.PresenceUnavailable {
+		t.Fatal("failed offline not retried")
+	}
+	applyViewing(t, owner, viewingMac, 1, "!a:example.invalid", false)
+	if len(*sent) != 2 {
+		t.Fatal("retry extended expired lease")
+	}
+}
+
+func TestViewingStopAndRestart(t *testing.T) {
+	owner, clock, sent := newViewingTestOwner(t)
+	applyViewing(t, owner, viewingMac, 1, "!a:example.invalid", true)
+	owner.stop()
+	clock.advance(time.Hour)
+	if len(*sent) != 1 {
+		t.Fatal("stopped owner sent presence")
+	}
+	if _, err := owner.apply(context.Background(), viewingMac, 2, "!a:example.invalid"); !errors.Is(err, errViewingStopped) {
+		t.Fatal("stopped owner accepted request")
+	}
+	restarted, _, fresh := newViewingTestOwner(t)
+	if err := restarted.legacy(context.Background(), types.PresenceUnavailable); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(*fresh, []types.Presence{types.PresenceUnavailable}) {
+		t.Fatal("restart restored online state")
+	}
+}
+
+func TestViewingConcurrentRequestsAndReconnect(t *testing.T) {
+	owner, _, sent := newViewingTestOwner(t)
+	var wait sync.WaitGroup
+	for generation := uint64(1); generation <= 100; generation++ {
+		wait.Add(1)
+		go func() {
+			defer wait.Done()
+			if _, err := owner.apply(context.Background(), viewingMac, generation, "!a:example.invalid"); err != nil {
+				t.Error(err)
+			}
+			if err := owner.legacy(context.Background(), types.PresenceUnavailable); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wait.Wait()
+	if owner.generation(viewingMac) != 100 {
+		t.Fatal("highest generation lost")
+	}
+	applyViewing(t, owner, viewingMac, 101, "", true)
+	if (*sent)[len(*sent)-1] != types.PresenceUnavailable {
+		t.Fatal("concurrent reconnect won over last left")
+	}
+}

diff --git a/pkg/connector/viewing.go b/pkg/connector/viewing.go
new file mode 100644
index 0000000000000000000000000000000000000000..b2aee4b4ce8cde434df7ebdfb3607a61b3813f54
--- /dev/null
+++ b/pkg/connector/viewing.go
@@ -0,0 +1,209 @@
+package connector
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/id"
+)
+
+// Os prazos são os aprovados para a extensão Chatty, não defaults do WhatsApp.
+const viewingLeaseTTL = 15 * time.Second
+const viewingRenewInterval = 5 * time.Second
+const viewingPresenceTimeout = 10 * time.Second
+const viewingRetryInterval = time.Second
+
+var errViewingStopped = errors.New("viewing presence owner stopped")
+
+type viewingDevice struct {
+	user   id.UserID
+	device id.DeviceID
+}
+
+type viewingLease struct {
+	generation uint64
+	room       id.RoomID
+	expires    time.Time
+}
+
+type viewingTimer interface{ Stop() bool }
+
+// Este lock é o único dono dos leases e de TODOS os envios de presença da conta.
+// Gerações encerradas ficam em memória até logout/restart para impedir replay;
+// a rota e o protocolo estão documentados no README do patch.
+type viewingPresence struct {
+	mu              sync.Mutex
+	ctx             context.Context
+	now             func() time.Time
+	afterFunc       func(time.Duration, func()) viewingTimer
+	send            func(context.Context, types.Presence) error
+	reportFailure   func()
+	leases          map[viewingDevice]viewingLease
+	confirmed       types.Presence
+	timer           viewingTimer
+	timerGeneration uint64
+	stopped         bool
+}
+
+func newViewingPresence(ctx context.Context, send func(context.Context, types.Presence) error, reportFailure func()) *viewingPresence {
+	owner := &viewingPresence{
+		ctx: ctx, now: time.Now,
+		afterFunc: func(delay time.Duration, callback func()) viewingTimer { return time.AfterFunc(delay, callback) },
+		send:      send, reportFailure: reportFailure,
+		leases: make(map[viewingDevice]viewingLease),
+	}
+	context.AfterFunc(ctx, owner.stop)
+	return owner
+}
+
+func (wa *WhatsAppClient) viewingOwner() *viewingPresence {
+	wa.viewingOnce.Do(func() {
+		wa.viewing = newViewingPresence(wa.Main.Bridge.BackgroundCtx, func(ctx context.Context, presence types.Presence) error {
+			if wa.Client == nil {
+				return bridgev2.ErrNotLoggedIn
+			}
+			return wa.Client.SendPresence(ctx, presence)
+		}, func() {
+			wa.UserLogin.Log.Warn().Msg("Failed to reconcile conversation viewing presence")
+		})
+	})
+	return wa.viewing
+}
+
+func (owner *viewingPresence) stop() {
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	owner.stopped = true
+	owner.cancelTimerLocked()
+	clear(owner.leases)
+}
+
+func (owner *viewingPresence) expireLocked() {
+	now := owner.now()
+	for key, lease := range owner.leases {
+		if lease.room != "" && !now.Before(lease.expires) {
+			lease.room = ""
+			owner.leases[key] = lease
+		}
+	}
+}
+
+func (owner *viewingPresence) desiredLocked() types.Presence {
+	for _, lease := range owner.leases {
+		if lease.room != "" {
+			return types.PresenceAvailable
+		}
+	}
+	return types.PresenceUnavailable
+}
+
+func (owner *viewingPresence) sendLocked(ctx context.Context, presence types.Presence) error {
+	ctx, cancel := context.WithTimeout(ctx, viewingPresenceTimeout)
+	defer cancel()
+	if err := owner.send(ctx, presence); err != nil {
+		owner.confirmed = ""
+		return err
+	}
+	owner.confirmed = presence
+	return nil
+}
+
+func (owner *viewingPresence) reconcileLocked(ctx context.Context) error {
+	owner.expireLocked()
+	desired := owner.desiredLocked()
+	if owner.confirmed == desired {
+		return nil
+	}
+	return owner.sendLocked(ctx, desired)
+}
+
+func (owner *viewingPresence) apply(ctx context.Context, device viewingDevice, generation uint64, room id.RoomID) (bool, error) {
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if owner.stopped || owner.ctx.Err() != nil {
+		return false, errViewingStopped
+	}
+	owner.expireLocked()
+	previous := owner.leases[device]
+	accepted := generation > previous.generation
+	if accepted {
+		owner.leases[device] = viewingLease{generation: generation, room: room, expires: owner.now().Add(viewingLeaseTTL)}
+	}
+	// Duplicatas podem repetir um envio que falhou, mas NUNCA prorrogam o lease.
+	err := owner.reconcileLocked(ctx)
+	owner.scheduleLocked(err != nil)
+	return accepted, err
+}
+
+func (owner *viewingPresence) generation(device viewingDevice) uint64 {
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	return owner.leases[device].generation
+}
+
+func (owner *viewingPresence) legacy(ctx context.Context, presence types.Presence) error {
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if owner.stopped || owner.ctx.Err() != nil {
+		return errViewingStopped
+	}
+	owner.expireLocked()
+	// Reenvio offline é intencional: push-name/conexão precisam anunciar o nome.
+	// Reaplicar a união dentro do mesmo lock impede um offline tardio apagar foco.
+	if err := owner.sendLocked(ctx, presence); err != nil {
+		owner.scheduleLocked(true)
+		return err
+	}
+	if presence == types.PresenceUnavailable && owner.desiredLocked() == types.PresenceAvailable {
+		err := owner.reconcileLocked(ctx)
+		owner.scheduleLocked(err != nil)
+		return err
+	}
+	owner.scheduleLocked(false)
+	return nil
+}
+
+func (owner *viewingPresence) cancelTimerLocked() {
+	owner.timerGeneration++
+	if owner.timer != nil {
+		owner.timer.Stop()
+		owner.timer = nil
+	}
+}
+
+func (owner *viewingPresence) scheduleLocked(retry bool) {
+	owner.cancelTimerLocked()
+	if owner.stopped || owner.ctx.Err() != nil {
+		return
+	}
+	now := owner.now()
+	var deadline time.Time
+	for _, lease := range owner.leases {
+		if lease.room != "" && (deadline.IsZero() || lease.expires.Before(deadline)) {
+			deadline = lease.expires
+		}
+	}
+	if retry && (deadline.IsZero() || now.Add(viewingRetryInterval).Before(deadline)) {
+		deadline = now.Add(viewingRetryInterval)
+	}
+	if deadline.IsZero() {
+		return
+	}
+	generation := owner.timerGeneration
+	owner.timer = owner.afterFunc(deadline.Sub(now), func() {
+		owner.mu.Lock()
+		defer owner.mu.Unlock()
+		if owner.stopped || owner.ctx.Err() != nil || generation != owner.timerGeneration {
+			return
+		}
+		err := owner.reconcileLocked(owner.ctx)
+		if err != nil {
+			owner.reportFailure()
+		}
+		owner.scheduleLocked(err != nil)
+	})
+}
diff --git a/pkg/connector/viewing_http.go b/pkg/connector/viewing_http.go
new file mode 100644
index 0000000000000000000000000000000000000000..407610325277e6a331cca0412869b846004636a4
--- /dev/null
+++ b/pkg/connector/viewing_http.go
@@ -0,0 +1,134 @@
+package connector
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/rs/zerolog"
+	"maunium.net/go/mautrix"
+	"maunium.net/go/mautrix/bridgev2/matrix"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/id"
+)
+
+const viewingRoute = "/v3/chatty/viewing/{loginID}"
+
+type viewingRequest struct {
+	Generation uint64    `json:"generation,string"`
+	RoomID     id.RoomID `json:"room_id"`
+	Left       bool      `json:"left"`
+}
+
+type viewingResponse struct {
+	Version      int    `json:"version"`
+	LeaseSeconds int    `json:"lease_seconds"`
+	RenewSeconds int    `json:"renew_seconds"`
+	Generation   uint64 `json:"generation,string"`
+	Accepted     bool   `json:"accepted"`
+}
+
+func (wa *WhatsAppConnector) registerViewingRoutes() {
+	mx, ok := wa.Bridge.Matrix.(*matrix.Connector)
+	if !ok {
+		return
+	}
+	router := mx.GetProvisioning().GetRouter()
+	router.HandleFunc("GET "+viewingRoute, wa.handleViewing)
+	router.HandleFunc("POST "+viewingRoute, wa.handleViewing)
+}
+
+func (wa *WhatsAppConnector) handleViewing(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	mx := wa.Bridge.Matrix.(*matrix.Connector)
+	user := mx.GetProvisioning().GetUser(r)
+	// O middleware também aceita shared secret/OpenID; esta rota exige token Matrix
+	// com aparelho comprovado por whoami, nunca identidade enviada pelo cliente.
+	token, bearer := strings.CutPrefix(r.Header.Get("Authorization"), "Bearer ")
+	if !bearer || token == "" || token == mx.Config.Provisioning.SharedSecret || strings.HasPrefix(token, "openid:") {
+		mautrix.MUnknownToken.WithMessage("A Matrix device access token is required").Write(w)
+		return
+	}
+	client, err := mautrix.NewClient(mx.Config.Homeserver.Address, user.MXID, token)
+	if err != nil {
+		mautrix.MUnknown.WithMessage("Matrix authentication unavailable").Write(w)
+		return
+	}
+	client.Log = zerolog.Nop()
+	client.DefaultHTTPRetries = 0
+	client.IgnoreRateLimit = true
+	client.Client = &http.Client{Timeout: 10 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	identity, err := client.Whoami(r.Context())
+	if err != nil || identity.UserID != user.MXID || identity.DeviceID == "" {
+		mautrix.MUnknownToken.WithMessage("A valid Matrix device access token is required").Write(w)
+		return
+	}
+	login, err := wa.Bridge.GetExistingUserLoginByID(r.Context(), networkid.UserLoginID(r.PathValue("loginID")))
+	if err != nil {
+		mautrix.MUnknown.WithMessage("Failed to look up login").Write(w)
+		return
+	}
+	if login == nil || login.UserMXID != identity.UserID {
+		mautrix.MForbidden.WithMessage("Login is not owned by this user").Write(w)
+		return
+	}
+	clientWA, ok := login.Client.(*WhatsAppClient)
+	if !ok || clientWA.Client == nil {
+		mautrix.MForbidden.WithMessage("WhatsApp login is unavailable").Write(w)
+		return
+	}
+	device := viewingDevice{user: identity.UserID, device: identity.DeviceID}
+	owner := clientWA.viewingOwner()
+	accepted := false
+	if r.Method == http.MethodPost {
+		var request viewingRequest
+		decoder := json.NewDecoder(r.Body)
+		decoder.DisallowUnknownFields()
+		if err = decoder.Decode(&request); err != nil || decoder.Decode(new(any)) != io.EOF || request.Generation == 0 || (request.RoomID == "") != request.Left {
+			mautrix.MBadJSON.WithMessage("Expected a positive generation string and either room_id or left:true").Write(w)
+			return
+		}
+		if request.RoomID != "" {
+			portal, lookupErr := wa.Bridge.GetPortalByMXID(r.Context(), request.RoomID)
+			if lookupErr != nil {
+				mautrix.MUnknown.WithMessage("Failed to look up portal").Write(w)
+				return
+			}
+			if portal == nil {
+				mautrix.MForbidden.WithMessage("Room is not a portal of this login").Write(w)
+				return
+			}
+			mapping, lookupErr := wa.Bridge.DB.UserPortal.Get(r.Context(), login.UserLogin, portal.PortalKey)
+			if lookupErr != nil {
+				mautrix.MUnknown.WithMessage("Failed to look up portal access").Write(w)
+				return
+			}
+			if mapping == nil || (portal.Receiver != "" && portal.Receiver != login.ID) {
+				mautrix.MForbidden.WithMessage("Room is not a portal of this login").Write(w)
+				return
+			}
+			var member event.MemberEventContent
+			if err = client.StateEvent(r.Context(), request.RoomID, event.StateMember, string(identity.UserID), &member); err != nil || member.Membership != event.MembershipJoin {
+				mautrix.MForbidden.WithMessage("User is not joined to this portal").Write(w)
+				return
+			}
+		}
+		accepted, err = owner.apply(r.Context(), device, request.Generation, request.RoomID)
+		if err != nil {
+			// Não serializar erros de rede: podem conter dados externos sensíveis.
+			mautrix.RespError{ErrCode: "FI.MAU.PRESENCE_FAILED", Err: "Failed to apply WhatsApp presence", StatusCode: http.StatusBadGateway}.Write(w)
+			return
+		}
+	}
+	w.Header().Set("Content-Type", "application/json")
+	response := viewingResponse{Version: 1, LeaseSeconds: int(viewingLeaseTTL / time.Second), RenewSeconds: int(viewingRenewInterval / time.Second), Generation: owner.generation(device), Accepted: accepted}
+	// A resposta é pequena e não contém token, sala ou conteúdo de conversa.
+	payload, _ := json.Marshal(response)
+	w.Header().Set("Content-Length", strconv.Itoa(len(payload)))
+	w.WriteHeader(http.StatusOK)
+	_, _ = w.Write(payload)
+}

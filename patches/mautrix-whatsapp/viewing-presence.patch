+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-whatsapp/pkg/waid"
+)
+
+type viewingChatSender struct {
+	chat  types.JID
+	state types.ChatPresence
+	media types.ChatPresenceMedia
+	calls int
+	err   error
+}
+
+func (sender *viewingChatSender) SendChatPresence(_ context.Context, chat types.JID, state types.ChatPresence, media types.ChatPresenceMedia) error {
+	sender.chat, sender.state, sender.media = chat, state, media
+	sender.calls++
+	return sender.err
+}
+
+func TestViewingOutgoingTypingUnchanged(t *testing.T) {
+	for _, typing := range []bool{true, false} {
+		for _, kind := range []bridgev2.TypingType{bridgev2.TypingTypeText, bridgev2.TypingTypeRecordingMedia, bridgev2.TypingTypeUploadingMedia} {
+			for _, focused := range []bool{true, false} {
+				client, _ := newHistoryClient(t)
+				owner, _, sent := newViewingTestOwner(t)
+				client.viewingOnce.Do(func() { client.viewing = owner })
+				if focused {
+					applyViewing(t, owner, viewingMac, 1, "!typing:example.invalid", true)
+				}
+				sender := &viewingChatSender{err: errors.New("synthetic typing send failure")}
+				chat := types.NewJID("100000000002", types.HiddenUserServer)
+				msg := &bridgev2.MatrixTyping{Portal: &bridgev2.Portal{Portal: &database.Portal{PortalKey: networkid.PortalKey{ID: waid.MakePortalID(chat)}}}, IsTyping: typing, Type: kind}
+				err := client.handleMatrixTyping(context.Background(), msg, sender)
+				if kind == bridgev2.TypingTypeUploadingMedia {
+					if err != nil || sender.calls != 0 {
+						t.Fatal("uploading-media must not send chat presence")
+					}
+					continue
+				}
+				wantState, wantMedia := types.ChatPresencePaused, types.ChatPresenceMediaText
+				if typing {
+					wantState = types.ChatPresenceComposing
+				}
+				if kind == bridgev2.TypingTypeRecordingMedia {
+					wantMedia = types.ChatPresenceMediaAudio
+				}
+				if !errors.Is(err, sender.err) || sender.calls != 1 || sender.chat != chat || sender.state != wantState || sender.media != wantMedia {
+					t.Fatalf("typing changed: %+v err=%v", sender, err)
+				}
+				wantPresenceCalls := 0
+				if focused {
+					wantPresenceCalls = 1
+				}
+				if len(*sent) != wantPresenceCalls {
+					t.Fatal("typing modified viewing presence")
+				}
+				if err = client.HandleMatrixTyping(context.Background(), msg); err == nil {
+					t.Fatal("public typing handler must propagate concrete disconnected transport failure")
+				}
+			}
+		}
+	}
+}
+
+type viewingTypingCall struct {
+	room    id.RoomID
+	kind    bridgev2.TypingType
+	timeout time.Duration
+}
+
+type viewingTypingMatrix struct {
+	*historyMatrix
+	calls []viewingTypingCall
+}
+
+type viewingTypingIntent struct {
+	*historyIntent
+	matrix *viewingTypingMatrix
+}
+
+func (mx *viewingTypingMatrix) GhostIntent(user networkid.UserID) bridgev2.MatrixAPI {
+	return &viewingTypingIntent{historyIntent: &historyIntent{matrix: mx.historyMatrix, mxid: mx.FormatGhostMXID(user)}, matrix: mx}
+}
+
+func (intent *viewingTypingIntent) EnsureInvited(context.Context, id.RoomID, id.UserID) error {
+	return nil
+}
+
+func (intent *viewingTypingIntent) MarkTyping(_ context.Context, room id.RoomID, kind bridgev2.TypingType, timeout time.Duration) error {
+	intent.matrix.calls = append(intent.matrix.calls, viewingTypingCall{room, kind, timeout})
+	return nil
+}
+
+func TestViewingIncomingTypingUnchanged(t *testing.T) {
+	client, history := newHistoryClient(t)
+	mx := &viewingTypingMatrix{historyMatrix: history}
+	client.Main.Bridge.Matrix = mx
+	client.Main.Bridge.Bot = &viewingTypingIntent{historyIntent: history.bot, matrix: mx}
+	chat := types.NewJID("100000000002", types.HiddenUserServer)
+	ctx := context.Background()
+	portal, err := client.Main.Bridge.GetPortalByKey(ctx, client.makeWAPortalKey(chat))
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.UserLogin.MarkInPortal(ctx, portal)
+	portal.MXID = "!typing:example.invalid"
+	if err = portal.Save(ctx); err != nil {
+		t.Fatal(err)
+	}
+	owner, _, _ := newViewingTestOwner(t)
+	client.viewingOnce.Do(func() { client.viewing = owner })
+	for _, focused := range []bool{true, false} {
+		if focused {
+			applyViewing(t, owner, viewingMac, 1, string(portal.MXID), true)
+		} else {
+			applyViewing(t, owner, viewingMac, 2, "", true)
+		}
+		for _, state := range []types.ChatPresence{types.ChatPresenceComposing, types.ChatPresencePaused} {
+			for _, media := range []types.ChatPresenceMedia{types.ChatPresenceMediaText, types.ChatPresenceMediaAudio} {
+				before := len(mx.calls)
+				client.handleWAChatPresence(ctx, &events.ChatPresence{MessageSource: types.MessageSource{Chat: chat, Sender: chat}, State: state, Media: media})
+				if len(mx.calls) != before+1 {
+					t.Fatal("incoming typing did not reach Matrix")
+				}
+				want := viewingTypingCall{room: portal.MXID, kind: bridgev2.TypingTypeText, timeout: 15 * time.Second}
+				if state == types.ChatPresencePaused {
+					want.timeout = 0
+				}
+				if media == types.ChatPresenceMediaAudio {
+					want.kind = bridgev2.TypingTypeRecordingMedia
+				}
+				if mx.calls[before] != want {
+					t.Fatalf("incoming typing=%+v want=%+v", mx.calls[before], want)
+				}
+			}
+		}
+	}
+}

+// The upstream retries HTTP/2 stream errors raised while reading media bodies.
+// Exercise the same path without enabling favorite events and without network I/O.
+func TestReviewerOrdinaryMediaHTTP2Retry(t *testing.T) {
+	cli := NewClient(&store.Device{}, waLog.Noop)
+	calls := 0
+	streamErr := http2.StreamError{StreamID: 1, Code: http2.ErrCodeInternal}
+	cli.SetMediaHTTPClient(&http.Client{Transport: reviewerMediaTransport(func(req *http.Request) (*http.Response, error) {
+		calls++
+		var body io.ReadCloser = io.NopCloser(strings.NewReader("synthetic original media"))
+		if calls == 1 {
+			body = reviewerFailedBody{err: streamErr}
+		}
+		return &http.Response{StatusCode: http.StatusOK, Body: body, Header: make(http.Header), Request: req}, nil
+	})})
+	data, _, err := cli.downloadPossiblyEncryptedMediaWithRetries(context.Background(), "https://synthetic.invalid/media", nil)
+	if err != nil || calls != 2 || string(data) != "synthetic original media" {
+		t.Fatalf("ordinary media lost HTTP/2 recovery: calls=%d data=%q err=%v preservesStreamType=%v", calls, data, err, errors.Is(err, streamErr))
+	}
+}

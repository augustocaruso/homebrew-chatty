+func TestFavoriteDecodedPrefixSurvivesLaterDecodeFailure(t *testing.T) {
+	cli, memory := favoriteReliabilityClient(t)
+	delivered := captureFavoriteStickerDelivery(cli)
+	raw := favoriteEncodedPatch(t, cli, memory, true)
+	first := &waServerSync.SyncdPatch{}
+	if err := proto.Unmarshal(raw, first); err != nil {
+		t.Fatal(err)
+	}
+	broken := proto.Clone(first).(*waServerSync.SyncdPatch)
+	broken.Version = &waServerSync.SyncdVersion{Version: proto.Uint64(2)}
+	broken.PatchMAC = bytes.Repeat([]byte{0}, 32)
+	var collected []any
+	cli.appStateSyncLock.Lock()
+	_, err := cli.applyAppStatePatches(cli.BackgroundEventCtx, appstate.WAPatchRegularLow, appstate.HashState{}, &appstate.PatchList{Name: appstate.WAPatchRegularLow, Patches: []*waServerSync.SyncdPatch{first, broken}}, false, &collected)
+	cli.appStateSyncLock.Unlock()
+	if err == nil {
+		t.Fatal("bad later patch did not fail MAC validation")
+	}
+	version, _, _ := memory.GetAppStateVersion(cli.BackgroundEventCtx, "regular_low")
+	if version != 1 {
+		t.Fatal("fixture did not persist the valid prefix")
+	}
+	batch := awaitFavoriteStickerDelivery(t, delivered)
+	if len(batch.Mutations) != 1 || !batch.Mutations[0].Action.GetStickerAction().GetIsFavorite() {
+		t.Fatal("valid decoded prefix was lost after a later failure")
+	}
+}

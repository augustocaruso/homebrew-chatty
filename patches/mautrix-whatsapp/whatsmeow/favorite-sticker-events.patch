+	waLog "go.mau.fi/whatsmeow/util/log"
+	"golang.org/x/net/http2"
+	"google.golang.org/protobuf/proto"
+)
+
+type favoriteFailedMediaBody struct{ err error }
+
+func (body favoriteFailedMediaBody) Read([]byte) (int, error) { return 0, body.err }
+func (body favoriteFailedMediaBody) Close() error             { return nil }
+
+func TestMediaHTTP2RetryPreservesPrivacy(t *testing.T) {
+	for _, favorites := range []bool{false, true} {
+		for _, source := range []string{"transport", "body"} {
+			t.Run(fmt.Sprintf("favorites_%t/%s", favorites, source), func(t *testing.T) {
+				const marker = "SYNTHETIC_PRIVATE_HTTP2_QUERY"
+				var logs bytes.Buffer
+				cli := NewClient(&store.Device{}, waLog.Zerolog(zerolog.New(&logs)))
+				cli.EmitFavoriteStickerEvents = favorites
+				calls := 0
+				streamErr := http2.StreamError{StreamID: 1, Code: http2.ErrCodeInternal, Cause: errors.New(marker)}
+				cli.SetMediaHTTPClient(&http.Client{Transport: favoriteTransport(func(req *http.Request) (*http.Response, error) {
+					calls++
+					var body io.ReadCloser = io.NopCloser(strings.NewReader("synthetic original media"))
+					if calls == 1 {
+						if source == "transport" {
+							return nil, streamErr
+						}
+						body = favoriteFailedMediaBody{err: streamErr}
+					}
+					return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: body, Request: req}, nil
+				})})
+				data, _, err := cli.downloadPossiblyEncryptedMediaWithRetries(context.Background(), "https://synthetic.invalid/"+marker+"?token="+marker, nil)
+				if err != nil || calls != 2 || string(data) != "synthetic original media" {
+					t.Fatalf("HTTP/2 recovery lost: calls=%d data=%q err=%v", calls, data, err)
+				}
+				if !strings.Contains(logs.String(), "retrying") || strings.Contains(logs.String(), marker) || strings.Contains(logs.String(), "https://") {
+					t.Fatalf("retry diagnosis missing or sensitive data logged: %s", &logs)
+				}
+			})
+		}
+	}
+}
+
+func TestMediaRetryUsesTypedErrors(t *testing.T) {
+	streamErr := http2.StreamError{StreamID: 1, Code: http2.ErrCodeInternal}
+	for _, scenario := range []struct {
+		name  string
+		err   error
+		retry bool
+	}{
+		{"stream", streamErr, true},
+		{"wrapped_stream", mediaRequestError{cause: fmt.Errorf("wrapped: %w", streamErr)}, true},
+		{"timeout", mediaRequestError{cause: &syntheticFavoriteNetError{}}, true},
+		{"http_retry", mediaRequestError{cause: DownloadHTTPError{Response: &http.Response{StatusCode: 503}}}, true},
+		{"http_permanent", mediaRequestError{cause: DownloadHTTPError{Response: &http.Response{StatusCode: 404}}}, false},
+		{"text_is_not_type", errors.New("stream error: synthetic permanent error"), false},
+		{"cancel", errors.Join(streamErr, context.Canceled), false},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			if got := shouldRetryMediaDownload(scenario.err); got != scenario.retry {
+				t.Fatalf("retry=%t, want %t", got, scenario.retry)
+			}
+		})
+	}
+}
+
+func (memory *favoriteMemoryStore) GetLatestAppStateSyncKeyID(context.Context) ([]byte, error) {
+	return []byte{1}, nil
+}
+
+func TestNonFavoriteConflictKeepsUpstreamValidation(t *testing.T) {
+	target := types.NewJID("12345", types.DefaultUserServer)
+	for _, patch := range []appstate.PatchInfo{
+		appstate.BuildPin(target, true),
+		appstate.BuildMarkChatAsRead(target, true, time.Time{}, nil),
+		appstate.BuildArchive(target, false, time.Time{}, nil),
+	} {
+		for _, invalid := range []string{"valid", "patch_mac", "snapshot_mac"} {
+			for _, favorites := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/%s/favorites_%t", patch.Mutations[0].Index[0], invalid, favorites), func(t *testing.T) {
+					cli, memory := favoriteReliabilityClient(t)
+					cli.EmitFavoriteStickerEvents = favorites
+					raw, err := cli.appStateProc.EncodePatch(cli.BackgroundEventCtx, []byte{1}, appstate.HashState{}, patch)
+					if err != nil {
+						t.Fatal(err)
+					}
+					conflict := &waServerSync.SyncdPatch{}
+					if err = proto.Unmarshal(raw, conflict); err != nil {
+						t.Fatal(err)
+					}
+					conflict.Version = &waServerSync.SyncdVersion{Version: proto.Uint64(1)}
+					want := appstate.ErrMismatchingPatchMAC
+					wantCalls, wantSyncErrors := 1, 1
+					if invalid == "patch_mac" {
+						conflict.PatchMAC = make([]byte, 32)
+					} else if invalid == "snapshot_mac" {
+						conflict.SnapshotMAC = make([]byte, 32)
+						want = appstate.ErrMismatchingLTHash
+					} else {
+						want = ErrAppStateUpdate
+						wantCalls, wantSyncErrors = 2, 0
+					}
+					raw, err = proto.Marshal(conflict)
+					if err != nil {
+						t.Fatal(err)
+					}
+					calls := 0
+					favoriteLocalAppStateSocket(t, cli, func(req *waBinary.Node) waBinary.Node {
+						calls++
+						// Simulate a fetch committing while the send is in flight.
+						if calls == 1 {
+							if err := memory.PutAppStateVersion(cli.BackgroundEventCtx, "regular_low", 1, [128]byte{}); err != nil {
+								t.Error(err)
+							}
+						}
+						code := 409
+						if calls > 1 {
+							code = 500
+						}
+						content := []waBinary.Node{{Tag: "error", Attrs: waBinary.Attrs{"code": code}}, {Tag: "patches", Content: []waBinary.Node{{Tag: "patch", Content: raw}}}}
+						return waBinary.Node{Tag: "iq", Attrs: waBinary.Attrs{"id": req.Attrs["id"], "type": "result"}, Content: []waBinary.Node{{Tag: "sync", Content: []waBinary.Node{{Tag: "collection", Attrs: waBinary.Attrs{"name": "regular_low", "type": "error"}, Content: content}}}}}
+					})
+					syncErrors := 0
+					cli.AddEventHandler(func(raw any) {
+						if _, ok := raw.(*events.AppStateSyncError); ok {
+							syncErrors++
+						}
+					})
+					err = cli.SendAppState(cli.BackgroundEventCtx, patch)
+					if !errors.Is(err, want) || calls != wantCalls || syncErrors != wantSyncErrors {
+						t.Fatalf("non-favorite conflict bypassed upstream validation: err=%v want=%v sends=%d syncErrors=%d", err, want, calls, syncErrors)
+					}
+					version, hash, _ := memory.GetAppStateVersion(cli.BackgroundEventCtx, "regular_low")
+					if version != 1 || (hash == ([128]byte{})) == (invalid == "valid") {
+						t.Fatal("conflict persistence differs from upstream validation")
+					}
+				})
+			}
+		}
+	}
+}

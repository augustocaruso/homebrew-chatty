+func TestFavoriteDownloadAndTraceDoNotLeakSecrets(t *testing.T) {
+	for _, scenario := range []string{"network_retry", "host_fallback", "invalid_path", "invalid_url", "trace"} {
+		t.Run(scenario, func(t *testing.T) {
+			const marker = "SYNTHETIC_PRIVATE_QUERY_MARKER"
+			var logs bytes.Buffer
+			logger := zerolog.New(&logs).Level(zerolog.TraceLevel)
+			cli := NewClient(&store.Device{}, waLog.Zerolog(logger))
+			cli.EmitFavoriteStickerEvents = true
+			cli.mediaConnCache = &MediaConn{FetchedAt: time.Now(), TTL: 3600, Hosts: []MediaConnHost{{Hostname: "synthetic.invalid"}, {Hostname: "other.invalid"}}}
+			ctx, cancel := context.WithCancel(logger.WithContext(context.Background()))
+			defer cancel()
+			calls := 0
+			cli.SetMediaHTTPClient(&http.Client{Transport: favoriteTransport(func(req *http.Request) (*http.Response, error) {
+				calls++
+				if scenario == "network_retry" {
+					if calls == 1 {
+						return nil, &syntheticFavoriteNetError{}
+					}
+					cancel()
+					return nil, context.Canceled
+				}
+				return nil, errors.New("synthetic transport failure")
+			})})
+			path := "/synthetic?token=" + marker
+			if scenario == "invalid_path" {
+				path = "invalid?token=" + marker
+			}
+			if scenario == "invalid_url" {
+				path = "/%zz?token=" + marker
+			}
+			key := []byte("SYNTHETIC_PRIVATE_MEDIA_KEY_123456")
+			if scenario == "trace" {
+				mutation := appstate.Mutation{Index: []string{appstate.IndexFavoriteSticker, "synthetic"}, Operation: waServerSync.SyncdMutation_SET, Action: &waSyncAction.SyncActionValue{StickerAction: &waSyncAction.StickerAction{DirectPath: proto.String(path), MediaKey: key}}}
+				cli.dispatchAppState(ctx, appstate.WAPatchRegularLow, mutation, false)
+			} else {
+				_, err := cli.Download(ctx, &waE2E.StickerMessage{DirectPath: proto.String(path), MediaKey: bytes.Repeat([]byte{1}, 32), FileEncSHA256: bytes.Repeat([]byte{2}, 32)})
+				if err == nil {
+					t.Fatal("synthetic failure did not reach downloader")
+				}
+				logger.Error().Err(err).Msg("Failed to publish favorite stickers")
+				if scenario == "host_fallback" && calls != 10 {
+					t.Fatalf("did not exercise host fallback: %d", calls)
+				}
+			}
+			for _, secret := range []string{marker, string(key), base64.StdEncoding.EncodeToString(key)} {
+				if strings.Contains(logs.String(), secret) {
+					t.Fatalf("%s leaked sensitive marker in logs", scenario)
+				}
+			}
+			if scenario == "network_retry" && (!strings.Contains(logs.String(), "timeout") || !strings.Contains(logs.String(), "retrying")) {
+				t.Fatal("network timeout/retry diagnosis was lost")
+			}
+			if scenario == "host_fallback" && !strings.Contains(logs.String(), "trying with next host") {
+				t.Fatal("host fallback diagnosis was lost")
+			}
+			if scenario != "trace" && !strings.Contains(logs.String(), "Failed to publish favorite stickers") {
+				t.Fatal("operational failure was hidden")
+			}
+		})
+	}
+}

@@ -0,0 +1,124 @@
+package whatsmeow
+
+import (
+	"context"
+	"testing"
+
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waServerSync"
+	"go.mau.fi/whatsmeow/proto/waSyncdSnapshotRecovery"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+func (memory *favoriteMemoryStore) DeleteAppStateVersion(context.Context, string) error {
+	memory.mu.Lock()
+	defer memory.mu.Unlock()
+	memory.state = appstate.HashState{}
+	clear(memory.macs)
+	return nil
+}
+
+func TestFavoriteConflictKeepsInputStateAndOrder(t *testing.T) {
+	cli, memory := favoriteReliabilityClient(t)
+	delivered := captureFavoriteStickerDelivery(cli)
+	first := &waServerSync.SyncdPatch{}
+	if err := proto.Unmarshal(favoriteEncodedPatch(t, cli, memory, true), first); err != nil {
+		t.Fatal(err)
+	}
+	var collected []any
+	if _, err := cli.applyAppStatePatches(cli.BackgroundEventCtx, appstate.WAPatchRegularLow, appstate.HashState{}, &appstate.PatchList{Name: appstate.WAPatchRegularLow, Patches: []*waServerSync.SyncdPatch{first}}, false, &collected); err != nil {
+		t.Fatal(err)
+	}
+	_ = awaitFavoriteStickerDelivery(t, delivered)
+	next := &waServerSync.SyncdPatch{}
+	if err := proto.Unmarshal(favoriteEncodedPatch(t, cli, memory, false), next); err != nil {
+		t.Fatal(err)
+	}
+	version, hash, _ := memory.GetAppStateVersion(cli.BackgroundEventCtx, "regular_low")
+	input := appstate.HashState{Version: version, Hash: hash}
+	if err := memory.PutAppStateVersion(cli.BackgroundEventCtx, "regular_low", 2, hash); err != nil {
+		t.Fatal(err)
+	}
+	state, err := cli.applyFavoriteStickerConflicts(cli.BackgroundEventCtx, input, &appstate.PatchList{Name: appstate.WAPatchRegularLow, Patches: []*waServerSync.SyncdPatch{next}}, &collected)
+	if err != nil {
+		t.Fatal(err)
+	}
+	batch := awaitFavoriteStickerDelivery(t, delivered)
+	if state.Version != 2 || len(batch.Mutations) != 1 || batch.Mutations[0].Action.GetStickerAction().GetIsFavorite() {
+		t.Fatal("conflict replay duplicated or reordered an already committed favorite")
+	}
+}
+
+func TestFavoriteRecoveryQueuesCompleteSnapshot(t *testing.T) {
+	cli, memory := favoriteReliabilityClient(t)
+	delivered := captureFavoriteStickerDelivery(cli)
+	completed := false
+	cli.AddEventHandlerWithSuccessStatus(func(raw any) bool {
+		if _, ok := raw.(*events.AppStateSyncComplete); !ok {
+			return true
+		}
+		if !cli.appStateSyncLock.TryLock() {
+			t.Error("recovery held app-state lock across an external callback")
+			return false
+		}
+		cli.appStateSyncLock.Unlock()
+		if err := cli.FetchAppState(cli.BackgroundEventCtx, appstate.WAPatchRegularLow, false, true); err != nil {
+			t.Error(err)
+			return false
+		}
+		completed = true
+		return true
+	})
+	raw, err := proto.Marshal(&waSyncdSnapshotRecovery.SyncdSnapshotRecovery{CollectionName: proto.String("regular_low"), Version: &waSyncdSnapshotRecovery.SyncdVersion{Version: proto.Uint64(3)}, CollectionLthash: make([]byte, 128)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := []*waE2E.PeerDataOperationRequestResponseMessage_PeerDataOperationResult{{SyncdSnapshotFatalRecoveryResponse: &waE2E.PeerDataOperationRequestResponseMessage_PeerDataOperationResult_SyncDSnapshotFatalRecoveryResponse{CollectionSnapshot: raw}}}
+	if !cli.handleAppStateRecovery(cli.BackgroundEventCtx, "synthetic-recovery", result) {
+		t.Fatal("recovery failed")
+	}
+	batch := awaitFavoriteStickerDelivery(t, delivered)
+	version, _, _ := memory.GetAppStateVersion(cli.BackgroundEventCtx, "regular_low")
+	if version != 3 || !completed || !batch.FromFullSync || len(batch.Mutations) != 0 {
+		t.Fatal("recovery did not enqueue its authoritative empty snapshot")
+	}
+	if !cli.handleAppStateRecovery(cli.BackgroundEventCtx, "synthetic-repeat", result) {
+		t.Fatal("repeated recovery failed")
+	}
+	select {
+	case <-delivered:
+		t.Fatal("already applied recovery was delivered again")
+	default:
+	}
+}
+
+func TestFavoritePendingMergeHonorsNewestSnapshot(t *testing.T) {
+	mutation := func(key string, operation waServerSync.SyncdMutation_SyncdOperation) appstate.Mutation {
+		return appstate.Mutation{Index: []string{appstate.IndexFavoriteSticker, key}, Operation: operation}
+	}
+	for _, scenario := range []struct {
+		name      string
+		batches   []*events.FavoriteStickerSync
+		full      bool
+		key       string
+		operation waServerSync.SyncdMutation_SyncdOperation
+		count     int
+	}{
+		{"newer_remove", []*events.FavoriteStickerSync{{Mutations: []appstate.Mutation{mutation("one", waServerSync.SyncdMutation_SET)}}, {Mutations: []appstate.Mutation{mutation("one", waServerSync.SyncdMutation_REMOVE)}}}, false, "one", waServerSync.SyncdMutation_REMOVE, 1},
+		{"delta_after_snapshot", []*events.FavoriteStickerSync{{FromFullSync: true, Mutations: []appstate.Mutation{mutation("one", waServerSync.SyncdMutation_SET)}}, {Mutations: []appstate.Mutation{mutation("one", waServerSync.SyncdMutation_REMOVE)}}}, true, "one", waServerSync.SyncdMutation_REMOVE, 1},
+		{"newer_empty_snapshot", []*events.FavoriteStickerSync{{Mutations: []appstate.Mutation{mutation("one", waServerSync.SyncdMutation_SET)}}, {FromFullSync: true}}, true, "", 0, 0},
+		{"newer_snapshot_replaces_pending", []*events.FavoriteStickerSync{{FromFullSync: true, Mutations: []appstate.Mutation{mutation("one", waServerSync.SyncdMutation_SET)}}, {FromFullSync: true, Mutations: []appstate.Mutation{mutation("two", waServerSync.SyncdMutation_SET)}}}, true, "two", waServerSync.SyncdMutation_SET, 1},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			merged := mergePendingFavoriteStickerSync(scenario.batches)
+			if merged.FromFullSync != scenario.full || len(merged.Mutations) != scenario.count {
+				t.Fatal("pending snapshot boundary changed")
+			}
+			if scenario.count != 0 && (merged.Mutations[0].Index[1] != scenario.key || merged.Mutations[0].Operation != scenario.operation) {
+				t.Fatal("latest pending mutation lost")
+			}
+		})
+	}
+}

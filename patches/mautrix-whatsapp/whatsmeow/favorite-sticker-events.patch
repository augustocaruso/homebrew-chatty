new file mode 100644
index 0000000000000000000000000000000000000000..a4fc4a4c8328c9b8494903375d29711f5a721183
--- /dev/null
+++ b/favorite_delivery.go
@@ -0,0 +1,80 @@
+package whatsmeow
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func (cli *Client) queueFavoriteStickerSync(batch *events.FavoriteStickerSync) {
+	cli.favoriteStickerQueueLock.Lock()
+	defer cli.favoriteStickerQueueLock.Unlock()
+	cli.favoriteStickerQueue = append(cli.favoriteStickerQueue, batch)
+	if !cli.favoriteStickerQueueRunning {
+		cli.favoriteStickerQueueRunning = true
+		go cli.deliverFavoriteStickerSync(cli.BackgroundEventCtx)
+	}
+}
+
+func (cli *Client) deliverFavoriteStickerSync(ctx context.Context) {
+	retryDelay := time.Second
+	for {
+		cli.favoriteStickerQueueLock.Lock()
+		if ctx.Err() != nil || len(cli.favoriteStickerQueue) == 0 {
+			cli.favoriteStickerQueueRunning = false
+			cli.favoriteStickerQueueLock.Unlock()
+			return
+		}
+		batch := cli.favoriteStickerQueue[0]
+		cli.favoriteStickerQueueLock.Unlock()
+		if !cli.dispatchEvent(batch) {
+			cli.favoriteStickerQueueLock.Lock()
+			cli.favoriteStickerQueue[0] = nil
+			cli.favoriteStickerQueue = cli.favoriteStickerQueue[1:]
+			cli.favoriteStickerQueueLock.Unlock()
+			retryDelay = time.Second
+			continue
+		}
+		select {
+		case <-ctx.Done():
+		case <-time.After(retryDelay):
+		}
+		cli.favoriteStickerQueueLock.Lock()
+		if len(cli.favoriteStickerQueue) > 1 {
+			cli.favoriteStickerQueue = []*events.FavoriteStickerSync{mergePendingFavoriteStickerSync(cli.favoriteStickerQueue)}
+		}
+		cli.favoriteStickerQueueLock.Unlock()
+		retryDelay = min(retryDelay*2, 30*time.Second)
+	}
+}
+
+func mergePendingFavoriteStickerSync(batches []*events.FavoriteStickerSync) *events.FavoriteStickerSync {
+	merged := &events.FavoriteStickerSync{}
+	indexes := make(map[string]int)
+	for _, batch := range batches {
+		if batch.FromFullSync {
+			merged.FromFullSync = true
+			merged.Mutations = nil
+			clear(indexes)
+		}
+		for _, mutation := range batch.Mutations {
+			key := strings.Join(mutation.Index, "\x00")
+			if index, ok := indexes[key]; ok {
+				merged.Mutations[index] = mutation
+			} else {
+				indexes[key] = len(merged.Mutations)
+				merged.Mutations = append(merged.Mutations, mutation)
+			}
+		}
+	}
+	return merged
+}
+
+func (cli *Client) applyFavoriteStickerConflicts(ctx context.Context, state appstate.HashState, patches *appstate.PatchList, collected *[]any) (appstate.HashState, error) {
+	cli.appStateSyncLock.Lock()
+	defer cli.appStateSyncLock.Unlock()
+	return cli.applyAppStatePatches(ctx, appstate.WAPatchRegularLow, state, patches, false, collected)
+}

+	"go.mau.fi/whatsmeow/proto/waServerSync"
+	"go.mau.fi/whatsmeow/proto/waSyncAction"
+	"go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/types/events"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+func captureFavoriteStickerDelivery(cli *Client) <-chan *events.FavoriteStickerSync {
+	delivered := make(chan *events.FavoriteStickerSync, 8)
+	cli.AddEventHandler(func(raw any) {
+		if batch, ok := raw.(*events.FavoriteStickerSync); ok {
+			delivered <- batch
+		}
+	})
+	return delivered
+}
+
+func awaitFavoriteStickerDelivery(t *testing.T, delivered <-chan *events.FavoriteStickerSync) *events.FavoriteStickerSync {
+	t.Helper()
+	select {
+	case batch := <-delivered:
+		return batch
+	case <-time.After(4 * time.Second):
+		t.Fatal("favorite delivery timed out")
+		return nil
+	}
+}
+
+func TestFavoriteStickerSnapshotIsolation(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		for _, full := range []bool{false, true} {
+			cli := NewClient(&store.Device{}, waLog.Noop)
+			cli.EmitFavoriteStickerEvents = enabled
+			delivered := captureFavoriteStickerDelivery(cli)
+			var collected []any
+			mutations := []appstate.Mutation{
+				{Operation: waServerSync.SyncdMutation_SET, Index: []string{appstate.IndexFavoriteSticker, "one"}, Action: &waSyncAction.SyncActionValue{}},
+				{Operation: waServerSync.SyncdMutation_REMOVE, Index: []string{appstate.IndexFavoriteSticker, "two"}},
+				{Operation: waServerSync.SyncdMutation_SET, Index: []string{appstate.IndexPin, "100@s.whatsapp.net"}, Action: &waSyncAction.SyncActionValue{}},
+			}
+			if err := cli.collectEventsToDispatch(context.Background(), appstate.WAPatchRegularLow, mutations, full, &collected); err != nil {
+				t.Fatal(err)
+			}
+			collected = cli.finishFavoriteStickerSync(appstate.WAPatchRegularLow, collected, full)
+			if enabled {
+				collected = append(collected, awaitFavoriteStickerDelivery(t, delivered))
+			}
+			favorites, generic, pins := 0, 0, 0
+			for _, raw := range collected {
+				switch evt := raw.(type) {
+				case *events.FavoriteStickerSync:
+					favorites++
+					if len(evt.Mutations) != 2 || evt.FromFullSync != full || evt.Mutations[1].Operation != waServerSync.SyncdMutation_REMOVE {
+						t.Fatalf("bad batch: %#v", evt)
+					}
+				case *events.AppState:
+					generic++
+				case *events.Pin:
+					pins++
+				default:
+					t.Fatalf("unexpected event: %T", raw)
+				}
+			}
+			if (enabled && favorites != 1) || (!enabled && favorites != 0) {
+				t.Fatalf("enabled=%v full=%v favorites=%d", enabled, full, favorites)
+			}
+			if (full && (generic != 0 || pins != 0)) || (!full && (generic != 2 || pins != 1)) {
+				t.Fatalf("unrelated delivery changed: full=%v generic=%d pins=%d", full, generic, pins)
+			}
+		}
+	}
+}
+
+func TestFavoriteStickerEmptyAndPagedSnapshot(t *testing.T) {
+	cli := NewClient(&store.Device{}, waLog.Noop)
+	cli.EmitFavoriteStickerEvents = true
+	delivered := captureFavoriteStickerDelivery(cli)
+	empty := cli.finishFavoriteStickerSync(appstate.WAPatchRegularLow, nil, true)
+	if batch := awaitFavoriteStickerDelivery(t, delivered); len(empty) != 0 || !batch.FromFullSync || len(batch.Mutations) != 0 {
+		t.Fatal("empty full snapshot must be observable")
+	}
+	pages := []any{
+		&events.FavoriteStickerSync{Mutations: []appstate.Mutation{{Index: []string{"favoriteSticker", "one"}}}},
+		&events.FavoriteStickerSync{Mutations: []appstate.Mutation{{Index: []string{"favoriteSticker", "two"}}}},
+	}
+	merged := cli.finishFavoriteStickerSync(appstate.WAPatchRegularLow, pages, true)
+	if batch := awaitFavoriteStickerDelivery(t, delivered); len(merged) != 0 || len(batch.Mutations) != 2 {
+		t.Fatal("snapshot pages were not combined")
+	}
+	if got := cli.finishFavoriteStickerSync(appstate.WAPatchRegularHigh, nil, true); len(got) != 0 {
+		t.Fatal("unrelated collection emitted favorites")
+	}
+	select {
+	case <-delivered:
+		t.Fatal("unrelated collection queued favorites")
+	default:
+	}
+}
diff --git a/favorite_fetch_test.go b/favorite_fetch_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d09201ccf126b15a80dadb57ae52422116bbc63a
--- /dev/null
+++ b/favorite_fetch_test.go
@@ -0,0 +1,157 @@
+package whatsmeow
+
+import (
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/sha256"
+	"encoding/binary"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/coder/websocket"
+	"go.mau.fi/whatsmeow/appstate"
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/proto/waServerSync"
+	"go.mau.fi/whatsmeow/proto/waSyncAction"
+	"go.mau.fi/whatsmeow/socket"
+	waLog "go.mau.fi/whatsmeow/util/log"
+	"golang.org/x/crypto/hkdf"
+	"google.golang.org/protobuf/proto"
+)
+
+func favoriteEncodedPatch(t *testing.T, cli *Client, memory *favoriteMemoryStore, favorite bool) []byte {
+	t.Helper()
+	version, hash, _ := memory.GetAppStateVersion(context.Background(), string(appstate.WAPatchRegularLow))
+	raw, err := cli.appStateProc.EncodePatch(context.Background(), []byte{1}, appstate.HashState{Version: version, Hash: hash}, appstate.PatchInfo{
+		Type:      appstate.WAPatchRegularLow,
+		Mutations: []appstate.MutationInfo{{Index: []string{appstate.IndexFavoriteSticker, "synthetic"}, Version: 1, Value: &waSyncAction.SyncActionValue{StickerAction: &waSyncAction.StickerAction{IsFavorite: proto.Bool(favorite)}}}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	patch := &waServerSync.SyncdPatch{}
+	if err = proto.Unmarshal(raw, patch); err != nil {
+		t.Fatal(err)
+	}
+	patch.Version = &waServerSync.SyncdVersion{Version: proto.Uint64(version + 1)}
+	raw, err = proto.Marshal(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return raw
+}
+
+func favoriteLocalFetchSocket(t *testing.T, cli *Client, nextPatch func() []byte) {
+	t.Helper()
+	favoriteLocalAppStateSocket(t, cli, func(request *waBinary.Node) waBinary.Node {
+		return waBinary.Node{Tag: "iq", Attrs: waBinary.Attrs{"id": request.Attrs["id"], "type": "result"}, Content: []waBinary.Node{{Tag: "sync", Content: []waBinary.Node{{Tag: "collection", Attrs: waBinary.Attrs{"name": "regular_low"}, Content: []waBinary.Node{{Tag: "patches", Content: []waBinary.Node{{Tag: "patch", Content: nextPatch()}}}}}}}}}
+	})
+}
+
+func favoriteLocalAppStateSocket(t *testing.T, cli *Client, respond func(*waBinary.Node) waBinary.Node) {
+	t.Helper()
+	const pattern = "synthetic-favorite-fetch-test"
+	salt := sha256.Sum256([]byte(pattern))
+	keys := make([]byte, 64)
+	if _, err := io.ReadFull(hkdf.New(sha256.New, nil, salt[:], nil), keys); err != nil {
+		t.Fatal(err)
+	}
+	makeCipher := func(key []byte) cipher.AEAD {
+		block, err := aes.NewCipher(key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		aead, err := cipher.NewGCM(block)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return aead
+	}
+	readKey, writeKey := makeCipher(keys[:32]), makeCipher(keys[32:])
+	nonce := func(count uint32) []byte {
+		iv := make([]byte, 12)
+		binary.BigEndian.PutUint32(iv[8:], count)
+		return iv
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := websocket.Accept(w, r, &websocket.AcceptOptions{InsecureSkipVerify: true})
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.CloseNow()
+		for count := uint32(0); ; count++ {
+			_, frame, err := conn.Read(r.Context())
+			if err != nil {
+				return
+			}
+			if len(frame) < 3 {
+				t.Error("short synthetic frame")
+				return
+			}
+			payload, err := readKey.Open(nil, nonce(count), frame[3:], nil)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			payload, err = waBinary.Unpack(payload)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			request, err := waBinary.Unmarshal(payload)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			if request.Attrs["xmlns"] != "w:sync:app:state" {
+				t.Error("unexpected synthetic IQ namespace")
+				return
+			}
+			response, err := waBinary.Marshal(respond(request))
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			encrypted := writeKey.Seal(nil, nonce(count), response, nil)
+			length := len(encrypted)
+			framed := append([]byte{byte(length >> 16), byte(length >> 8), byte(length)}, encrypted...)
+			if err = conn.Write(r.Context(), websocket.MessageBinary, framed); err != nil {
+				return
+			}
+		}
+	}))
+	t.Cleanup(server.Close)
+	frames := socket.NewFrameSocket(waLog.Noop, server.Client())
+	frames.URL = "ws" + strings.TrimPrefix(server.URL, "http")
+	frames.Header = nil
+	if err := frames.Connect(cli.BackgroundEventCtx); err != nil {
+		t.Fatal(err)
+	}
+	handshake := socket.NewNoiseHandshake()
+	handshake.Start(pattern, nil)
+	noise, err := handshake.Finish(frames, func(ctx context.Context, frame []byte) {
+		payload, unpackErr := waBinary.Unpack(frame)
+		if unpackErr != nil {
+			t.Error(unpackErr)
+			return
+		}
+		node, decodeErr := waBinary.Unmarshal(payload)
+		if decodeErr != nil {
+			t.Error(decodeErr)
+			return
+		}
+		if !cli.receiveResponse(ctx, node) {
+			t.Error("synthetic IQ response had no waiter")
+		}
+	}, func(context.Context, *socket.NoiseSocket, bool) {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli.socket = noise
+	t.Cleanup(func() { noise.Stop(true, false) })
+}

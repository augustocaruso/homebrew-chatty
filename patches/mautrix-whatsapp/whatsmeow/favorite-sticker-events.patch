@@ -0,0 +1,424 @@
+package whatsmeow
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waServerSync"
+	"go.mau.fi/whatsmeow/proto/waSyncAction"
+	"go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/types/events"
+	waLog "go.mau.fi/whatsmeow/util/log"
+	"google.golang.org/protobuf/proto"
+)
+
+type favoriteMemoryStore struct {
+	store.AppStateStore
+	store.AppStateSyncKeyStore
+	mu    sync.Mutex
+	state appstate.HashState
+	macs  map[string][]byte
+}
+
+func (s *favoriteMemoryStore) GetAppStateSyncKey(context.Context, []byte) (*store.AppStateSyncKey, error) {
+	return &store.AppStateSyncKey{Data: bytes.Repeat([]byte{7}, 32)}, nil
+}
+func (s *favoriteMemoryStore) PutAppStateVersion(_ context.Context, _ string, version uint64, hash [128]byte) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.state = appstate.HashState{Version: version, Hash: hash}
+	return nil
+}
+func (s *favoriteMemoryStore) GetAppStateVersion(context.Context, string) (uint64, [128]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.state.Version, s.state.Hash, nil
+}
+func (s *favoriteMemoryStore) GetAppStateMutationMAC(_ context.Context, _ string, index []byte) ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.macs[string(index)], nil
+}
+func (s *favoriteMemoryStore) PutAppStateMutationMACs(_ context.Context, _ string, _ uint64, macs []store.AppStateMutationMAC) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, mac := range macs {
+		s.macs[string(mac.IndexMAC)] = mac.ValueMAC
+	}
+	return nil
+}
+func (s *favoriteMemoryStore) DeleteAppStateMutationMACs(_ context.Context, _ string, indexes [][]byte) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, index := range indexes {
+		delete(s.macs, string(index))
+	}
+	return nil
+}
+
+func favoriteReliabilityClient(t *testing.T) (*Client, *favoriteMemoryStore) {
+	t.Helper()
+	memory := &favoriteMemoryStore{macs: make(map[string][]byte)}
+	cli := NewClient(&store.Device{AppState: memory, AppStateKeys: memory}, waLog.Noop)
+	cli.EmitFavoriteStickerEvents = true
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	cli.BackgroundEventCtx = ctx
+	t.Cleanup(cancel)
+	return cli, memory
+}
+
+func favoriteDecodedBatch(t *testing.T, cli *Client, memory *favoriteMemoryStore, favorite, full bool) []any {
+	t.Helper()
+	cli.appStateSyncLock.Lock()
+	defer cli.appStateSyncLock.Unlock()
+	version, hash, _ := memory.GetAppStateVersion(context.Background(), string(appstate.WAPatchRegularLow))
+	state := appstate.HashState{Version: version, Hash: hash}
+	raw, err := cli.appStateProc.EncodePatch(context.Background(), []byte{1}, state, appstate.PatchInfo{
+		Type:      appstate.WAPatchRegularLow,
+		Mutations: []appstate.MutationInfo{{Index: []string{appstate.IndexFavoriteSticker, "synthetic"}, Version: 1, Value: &waSyncAction.SyncActionValue{StickerAction: &waSyncAction.StickerAction{IsFavorite: proto.Bool(favorite)}}}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	patch := &waServerSync.SyncdPatch{}
+	if err = proto.Unmarshal(raw, patch); err != nil {
+		t.Fatal(err)
+	}
+	patch.Version = &waServerSync.SyncdVersion{Version: proto.Uint64(version + 1)}
+	var collected []any
+	if _, err = cli.applyAppStatePatches(context.Background(), appstate.WAPatchRegularLow, state, &appstate.PatchList{Name: appstate.WAPatchRegularLow, Patches: []*waServerSync.SyncdPatch{patch}}, full, &collected); err != nil {
+		t.Fatal(err)
+	}
+	return cli.finishFavoriteStickerSync(appstate.WAPatchRegularLow, collected, full)
+}
+
+func favoriteDispatchCollected(cli *Client, collected []any) {
+	for _, event := range collected {
+		cli.dispatchEvent(event)
+	}
+}
+
+func favoriteAwait(t *testing.T, ch <-chan struct{}, reason string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(4 * time.Second):
+		t.Fatal(reason)
+	}
+}
+
+func TestFavoritePublicationFailureIsRetriedAfterDecode(t *testing.T) {
+	cli, memory := favoriteReliabilityClient(t)
+	patches := make(chan []byte, 4)
+	favoriteLocalFetchSocket(t, cli, func() []byte { return <-patches })
+	var fail atomic.Bool
+	var present atomic.Bool
+	var requests atomic.Int32
+	published := make(chan struct{}, 8)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if fail.Load() {
+			w.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		body, _ := io.ReadAll(r.Body)
+		present.Store(string(body) == "true")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+	failed := make(chan struct{}, 8)
+	cli.AddEventHandlerWithSuccessStatus(func(raw any) bool {
+		batch, ok := raw.(*events.FavoriteStickerSync)
+		if !ok {
+			return true
+		}
+		version, _, _ := memory.GetAppStateVersion(context.Background(), string(appstate.WAPatchRegularLow))
+		if version == 0 {
+			t.Error("publication happened before cryptographic persistence")
+		}
+		req, _ := http.NewRequestWithContext(cli.BackgroundEventCtx, http.MethodPut, server.URL, strings.NewReader(fmt.Sprint(batch.Mutations[len(batch.Mutations)-1].Action.GetStickerAction().GetIsFavorite())))
+		resp, err := server.Client().Do(req)
+		if err != nil {
+			return false
+		}
+		_ = resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			failed <- struct{}{}
+			return false
+		}
+		published <- struct{}{}
+		return true
+	})
+	favoriteDispatchCollected(cli, favoriteDecodedBatch(t, cli, memory, true, true))
+	favoriteAwait(t, published, "initial snapshot was not published")
+	fail.Store(true)
+	patches <- favoriteEncodedPatch(t, cli, memory, false)
+	if err := cli.FetchAppState(cli.BackgroundEventCtx, appstate.WAPatchRegularLow, false, false); err != nil {
+		t.Fatal(err)
+	}
+	favoriteAwait(t, failed, "publication failure was not exercised")
+	version, hash, _ := memory.GetAppStateVersion(context.Background(), string(appstate.WAPatchRegularLow))
+	fail.Store(false)
+	favoriteAwait(t, published, "lost delta: no automatic retry after publication failure")
+	if present.Load() {
+		t.Fatal("recovered publication did not remove favorite")
+	}
+	after, afterHash, _ := memory.GetAppStateVersion(context.Background(), string(appstate.WAPatchRegularLow))
+	if version != 2 || after != version || afterHash != hash {
+		t.Fatal("retry changed cryptographic version/hash")
+	}
+	before := requests.Load()
+	patches <- favoriteEncodedPatch(t, cli, memory, false)
+	if err := cli.FetchAppState(cli.BackgroundEventCtx, appstate.WAPatchRegularLow, false, false); err != nil {
+		t.Fatal(err)
+	}
+	favoriteAwait(t, published, "repeated removal was not delivered")
+	if present.Load() || requests.Load() != before+1 {
+		t.Fatal("repetition changed the final state")
+	}
+}

+func TestFavoriteFetchDispatchOrder(t *testing.T) {
+	cli, memory := favoriteReliabilityClient(t)
+	_ = memory.PutAppStateVersion(context.Background(), "regular_low", 1, [128]byte{})
+	patches := make(chan []byte, 4)
+	favoriteLocalFetchSocket(t, cli, func() []byte { return <-patches })
+	olderDecoded, releaseOlder := make(chan struct{}), make(chan struct{})
+	release := sync.OnceFunc(func() { close(releaseOlder) })
+	defer release()
+	published := make(chan struct{}, 8)
+	var present atomic.Bool
+	cli.AddEventHandler(func(raw any) {
+		if event, ok := raw.(*events.AppState); ok && event.SyncActionValue.GetStickerAction().GetIsFavorite() {
+			close(olderDecoded)
+			<-releaseOlder
+		}
+		if event, ok := raw.(*events.FavoriteStickerSync); ok {
+			present.Store(event.Mutations[len(event.Mutations)-1].Action.GetStickerAction().GetIsFavorite())
+			published <- struct{}{}
+		}
+	})
+	patches <- favoriteEncodedPatch(t, cli, memory, true)
+	done := make(chan error, 1)
+	go func() { done <- cli.FetchAppState(cli.BackgroundEventCtx, appstate.WAPatchRegularLow, false, false) }()
+	favoriteAwait(t, olderDecoded, "older fetch did not reach outer dispatch barrier")
+	patches <- favoriteEncodedPatch(t, cli, memory, false)
+	newerError := cli.FetchAppState(cli.BackgroundEventCtx, appstate.WAPatchRegularLow, false, false)
+	release()
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if newerError != nil {
+		t.Fatal(newerError)
+	}
+	favoriteAwait(t, published, "first native fetch batch missing")
+	favoriteAwait(t, published, "second native fetch batch missing")
+	if present.Load() {
+		t.Fatal("native concurrent FetchAppState published older SET after newer unfavorite")
+	}
+}

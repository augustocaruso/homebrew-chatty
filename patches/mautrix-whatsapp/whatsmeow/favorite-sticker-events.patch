+func TestFavoriteDeliveryPreservesDecodeOrder(t *testing.T) {
+	for _, full := range []bool{false, true} {
+		t.Run(fmt.Sprint("older_full_", full), func(t *testing.T) {
+			cli, memory := favoriteReliabilityClient(t)
+			var present atomic.Bool
+			published := make(chan struct{}, 8)
+			cli.AddEventHandler(func(raw any) {
+				if batch, ok := raw.(*events.FavoriteStickerSync); ok {
+					present.Store(batch.Mutations[len(batch.Mutations)-1].Action.GetStickerAction().GetIsFavorite())
+					published <- struct{}{}
+				}
+			})
+			olderDecoded := make(chan struct{})
+			releaseOlder := make(chan struct{})
+			release := sync.OnceFunc(func() { close(releaseOlder) })
+			defer release()
+			olderDone := make(chan struct{})
+			go func() {
+				defer close(olderDone)
+				older := favoriteDecodedBatch(t, cli, memory, true, full)
+				close(olderDecoded)
+				<-releaseOlder
+				favoriteDispatchCollected(cli, older)
+			}()
+			favoriteAwait(t, olderDecoded, "older decode did not reach barrier")
+			favoriteDispatchCollected(cli, favoriteDecodedBatch(t, cli, memory, false, false))
+			release()
+			favoriteAwait(t, olderDone, "older dispatch did not finish")
+			favoriteAwait(t, published, "first batch missing")
+			favoriteAwait(t, published, "second batch missing")
+			if present.Load() {
+				t.Fatal("older SET/snapshot undid newer unfavorite after dispatch inversion")
+			}
+		})
+	}
+}

+	current := favoriteStickerPack{Fields: map[string]json.RawMessage{"pack": json.RawMessage(`{"display_name":"My pack","usage":["emoticon","sticker"],"custom":true}`), "custom": json.RawMessage(`true`)}, Images: map[string]json.RawMessage{change.Key: entry, "foreign": json.RawMessage(`{"url":"mxc://synthetic/foreign"}`), foreignKey: entry}}

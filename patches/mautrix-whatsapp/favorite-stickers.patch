+)
+
+type syntheticFavoriteMatrix struct {
+	bridgev2.MatrixConnector
+	intent bridgev2.MatrixAPI
+}
+
+func (connector *syntheticFavoriteMatrix) NewUserIntent(_ context.Context, _ id.UserID, token string) (bridgev2.MatrixAPI, string, error) {
+	return connector.intent, token, nil
+}
+
+func TestFavoriteStickerEventUsesDoublePuppet(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		state, client := newSyntheticFavoriteServer(t)
+		var intent bridgev2.MatrixAPI
+		if enabled {
+			service, err := appservice.CreateFull(appservice.CreateOpts{Registration: &appservice.Registration{SenderLocalpart: "synthetic-bot"}, HomeserverDomain: "example.invalid", HomeserverURL: client.HomeserverURL.String()})
+			if err != nil {
+				t.Fatal(err)
+			}
+			service.DoublePuppetValue = "synthetic-whatsapp"
+			puppet := service.NewIntentAPI("synthetic")
+			puppet.Client = client
+			puppet.IsCustomPuppet = true
+			intent = &matrix.ASIntent{Matrix: puppet}
+		}
+		bridge := &bridgev2.Bridge{BackgroundCtx: context.Background(), Matrix: &syntheticFavoriteMatrix{intent: intent}}
+		login := &bridgev2.UserLogin{UserLogin: &database.UserLogin{ID: "synthetic-login"}, Log: zerolog.Nop()}
+		login.User = &bridgev2.User{User: &database.User{MXID: client.UserID, AccessToken: "synthetic-token"}, Bridge: bridge, Log: zerolog.Nop()}
+		wa := &WhatsAppClient{Main: &WhatsAppConnector{Bridge: bridge}, UserLogin: login, MC: noopMCInstance}
+		data := []byte("synthetic")
+		mutation := syntheticFavorite(data, false)
+		change, _ := favoriteStickerMutation(favoriteStickerPrefix("synthetic-login"), mutation)
+		entry := favoriteStickerEntry(change, favoriteStickerMedia{Data: data, MimeType: "image/webp"}, "mxc://synthetic/owned", "")
+		state.content["images"], _ = json.Marshal(map[string]json.RawMessage{change.Key: entry, "foreign": json.RawMessage(`{"url":"mxc://synthetic/foreign"}`)})
+		mutation.Operation = waServerSync.SyncdMutation_REMOVE
+		mutation.Action = nil
+		success := wa.handleWAEvent(&events.FavoriteStickerSync{Mutations: []appstate.Mutation{mutation}, FromFullSync: true})
+		if success != enabled {
+			t.Fatalf("enabled=%v success=%v", enabled, success)
+		}
+		if enabled {
+			if state.writes != 1 || len(syntheticImages(t, state)) != 1 || !wa.favoriteStickerSnapshotSeen.Load() {
+				t.Fatal("event did not publish as double puppet")
+			}
+		} else if state.writes != 0 || len(state.uploads) != 0 {
+			t.Fatal("missing double puppet caused an effect")
+		}
+	}
+}
+
+type syntheticFavoriteServer struct {
+	mu            sync.Mutex
+	content       map[string]json.RawMessage
+	writes        int
+	uploads       [][]byte
+	mimes         []string
+	readError     int
+	writeError    int
+	uploadError   int
+	uploadCalls   int
+	uploadErrorAt int
+	onUpload      func(map[string]json.RawMessage)
+}
+
+func newSyntheticFavoriteServer(t *testing.T) (*syntheticFavoriteServer, *mautrix.Client) {
+	t.Helper()
+	state := &syntheticFavoriteServer{content: map[string]json.RawMessage{"images": json.RawMessage(`{"other_client":{"url":"mxc://synthetic/other","custom":true}}`), "custom": json.RawMessage(`{"preserved":true}`)}}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		state.mu.Lock()
+		defer state.mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		if r.Header.Get("Authorization") != "Bearer synthetic-token" {
+			t.Error("wrong double puppet identity")
+		}
+		if strings.Contains(r.URL.Path, "/upload") {
+			state.uploadCalls++
+			if state.uploadError != 0 && (state.uploadErrorAt == 0 || state.uploadCalls == state.uploadErrorAt) {
+				w.WriteHeader(state.uploadError)
+				_, _ = io.WriteString(w, `{"errcode":"M_UNKNOWN","error":"synthetic"}`)
+				return
+			}
+			data, err := io.ReadAll(r.Body)
+			if err != nil {
+				t.Error(err)
+			}
+			state.uploads = append(state.uploads, data)
+			state.mimes = append(state.mimes, r.Header.Get("Content-Type"))
+			if state.onUpload != nil {
+				state.onUpload(state.content)
+			}
+			_, _ = fmt.Fprintf(w, `{"content_uri":"mxc://synthetic/upload%d"}`, len(state.uploads))
+			return
+		}
+		if !strings.Contains(r.URL.Path, "/user/@synthetic:example.invalid/account_data/im.ponies.user_emotes") {
+			t.Errorf("unexpected route: %s", r.URL.Path)
+			w.WriteHeader(404)
+			return
+		}
+		switch r.Method {
+		case http.MethodGet:
+			if state.readError != 0 {
+				w.WriteHeader(state.readError)
+				_, _ = io.WriteString(w, `{"errcode":"M_FORBIDDEN","error":"synthetic"}`)
+				return
+			}
+			if state.content == nil {
+				w.WriteHeader(404)
+				_, _ = io.WriteString(w, `{"errcode":"M_NOT_FOUND","error":"absent"}`)
+				return
+			}
+			_ = json.NewEncoder(w).Encode(state.content)
+		case http.MethodPut:
+			if state.writeError != 0 {
+				w.WriteHeader(state.writeError)
+				_, _ = io.WriteString(w, `{"errcode":"M_FORBIDDEN","error":"synthetic"}`)
+				return
+			}
+			state.writes++
+			if err := json.NewDecoder(r.Body).Decode(&state.content); err != nil {
+				t.Error(err)
+			}
+			_, _ = io.WriteString(w, `{}`)
+		default:
+			t.Errorf("unexpected method: %s", r.Method)
+		}
+	}))
+	t.Cleanup(server.Close)
+	client, err := mautrix.NewClient(server.URL, "@synthetic:example.invalid", "synthetic-token")
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.DefaultHTTPRetries = 0
+	return state, client
+}

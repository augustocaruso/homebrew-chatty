+func TestFavoriteQueueDoesNotRetryPublishedPartialBatch(t *testing.T) {
+	data := []byte("synthetic expired delta")
+	fixture := newFavoriteRetryFixture(t, func(context.Context, *waE2E.StickerMessage) ([]byte, error) {
+		return nil, whatsmeow.ErrMediaDownloadFailedWith403
+	})
+	memory := &favoritePipelineStore{macs: make(map[string][]byte)}
+	cli := whatsmeow.NewClient(&store.Device{AppState: memory, AppStateKeys: memory}, waLog.Noop)
+	cli.EmitFavoriteStickerEvents = true
+	cli.BackgroundEventCtx = fixture.wa.Main.Bridge.BackgroundCtx
+	delivered := make(chan bool, 4)
+	cli.AddEventHandlerWithSuccessStatus(func(raw any) bool {
+		if _, ok := raw.(*events.FavoriteStickerSync); !ok {
+			return true
+		}
+		success := fixture.wa.handleWAEvent(raw)
+		delivered <- success
+		return success
+	})
+	mutation := syntheticFavorite(data, false)
+	applySyntheticFavoriteDelta(t, cli, mutation)
+	await := func() {
+		t.Helper()
+		select {
+		case success := <-delivered:
+			if !success {
+				t.Fatal("expired media kept batch queued")
+			}
+		case <-time.After(4 * time.Second):
+			t.Fatal("favorite queue did not advance")
+		}
+	}
+	await()
+	// EncodePatch usa SET; isFavorite=false exerce a remoção na mesma fila real.
+	mutation = syntheticFavorite(data, false)
+	mutation.Action.StickerAction.IsFavorite = new(false)
+	applySyntheticFavoriteDelta(t, cli, mutation)
+	await()
+	fixture.wa.Main.favoriteStickerLock.Lock(fixture.wa.UserLogin.User.MXID)
+	pending := len(fixture.wa.favoriteStickerRetries.pending)
+	fixture.wa.Main.favoriteStickerLock.Unlock(fixture.wa.UserLogin.User.MXID)
+	if pending != 0 || len(syntheticImages(t, fixture.matrix)) != 1 {
+		t.Fatal("queue retained expired favorite after remove")
+	}
+}

+				t.Fatal("failed Matrix effect lost recovered favorite")
+			}
+		})
+	}
+}
+
+func syntheticFavoriteReupload(fixture *favoriteRetryFixture, data []byte) *events.Message {
+	return &events.Message{Info: types.MessageInfo{MessageSource: types.MessageSource{IsFromMe: true, Sender: fixture.wa.JID}}, Message: &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{
+		Type: waE2E.ProtocolMessage_PEER_DATA_OPERATION_REQUEST_RESPONSE_MESSAGE.Enum(), PeerDataOperationRequestResponseMessage: &waE2E.PeerDataOperationRequestResponseMessage{
+			PeerDataOperationRequestType: waE2E.PeerDataOperationRequestType_UPLOAD_STICKER.Enum(), StanzaID: proto.String(fixture.requestID),
+			PeerDataOperationResult: []*waE2E.PeerDataOperationRequestResponseMessage_PeerDataOperationResult{{MediaUploadResult: waMmsRetry.MediaRetryNotification_SUCCESS.Enum(), StickerMessage: &waE2E.StickerMessage{FileSHA256: sha256Bytes(data), DirectPath: proto.String("/synthetic-refreshed"), MediaKey: bytes.Repeat([]byte{3}, 32), FileEncSHA256: bytes.Repeat([]byte{4}, 32)}}},
+		}}}}
+}
+
+func TestFavoritePeerReuploadRefreshAndLateResponse(t *testing.T) {
+	for _, scenario := range []string{"valid", "wrong_id", "wrong_hash", "foreign_sender", "not_from_me", "companion_sender", "failure", "missing_result", "remove_before_response", "remove_after_response"} {
+		t.Run(scenario, func(t *testing.T) {
+			data := []byte("synthetic refresh")
+			attempts := 0
+			fixture := newFavoriteRetryFixture(t, func(_ context.Context, msg *waE2E.StickerMessage) ([]byte, error) {
+				attempts++
+				if msg.GetDirectPath() != "/synthetic-refreshed" {
+					return nil, whatsmeow.ErrMediaDownloadFailedWith403
+				}
+				if !bytes.Equal(msg.MediaKey, bytes.Repeat([]byte{3}, 32)) || !bytes.Equal(msg.FileEncSHA256, bytes.Repeat([]byte{4}, 32)) {
+					t.Fatal("refresh lost encryption details")
+				}
+				return data, nil
+			})
+			mutation := syntheticFavorite(data, false)
+			batch := &events.FavoriteStickerSync{Mutations: []appstate.Mutation{mutation}}
+			if !fixture.wa.handleWAEvent(batch) {
+				t.Fatal("initial defer failed")
+			}
+			request := favoriteStickerReuploadRequest(sha256Bytes(data)).ProtocolMessage.PeerDataOperationRequestMessage
+			if request.GetPeerDataOperationRequestType() != waE2E.PeerDataOperationRequestType_UPLOAD_STICKER || request.RequestStickerReupload[0].GetFileSHA256() != base64.StdEncoding.EncodeToString(sha256Bytes(data)) {
+				t.Fatal("invalid native reupload request")
+			}
+			evt := syntheticFavoriteReupload(fixture, data)
+			response := evt.Message.ProtocolMessage.PeerDataOperationRequestResponseMessage
+			remove := func() {
+				mutation.Operation = waServerSync.SyncdMutation_REMOVE
+				mutation.Action = nil
+				if !fixture.wa.handleWAEvent(&events.FavoriteStickerSync{Mutations: []appstate.Mutation{mutation}}) {
+					t.Fatal("remove failed")
+				}
+			}
+			switch scenario {
+			case "wrong_id":
+				response.StanzaID = proto.String("other")
+			case "wrong_hash":
+				response.PeerDataOperationResult[0].StickerMessage.FileSHA256 = sha256Bytes([]byte("other"))
+			case "foreign_sender":
+				evt.Info.Sender = types.NewJID("999", types.DefaultUserServer)
+			case "not_from_me":
+				evt.Info.IsFromMe = false
+			case "companion_sender":
+				evt.Info.Sender.Device = 4
+			case "failure":
+				response.PeerDataOperationResult[0].MediaUploadResult = waMmsRetry.MediaRetryNotification_NOT_FOUND.Enum()
+			case "missing_result":
+				response.PeerDataOperationResult[0].MediaUploadResult = nil
+			case "remove_before_response":
+				remove()
+			}
+			stale := fixture.fire
+			if !fixture.wa.handleWAEvent(evt) {
+				t.Fatal("peer response not consumed")
+			}
+			if scenario == "remove_after_response" {
+				remove()
+			}
+			if strings.HasPrefix(scenario, "remove_") {
+				stale()
+				if len(syntheticImages(t, fixture.matrix)) != 1 {
+					t.Fatal("late response resurrected favorite")
+				}
+				return
+			}
+			if !fixture.wa.handleWAEvent(batch) || attempts != 1 {
+				t.Fatal("response bypassed backoff")
+			}
+			fixture.advance(t)
+			expected := 1
+			if scenario == "valid" {
+				expected = 2
+			}
+			if len(syntheticImages(t, fixture.matrix)) != expected {
+				t.Fatal("refresh result accepted incorrectly")
+			}
+		})
+	}
+}
+
+func TestFavoriteRetryLogRedactsExternalError(t *testing.T) {
+	const secret = "SYNTHETIC_PRIVATE_URL_AND_KEY"
+	fixture := newFavoriteRetryFixture(t, func(context.Context, *waE2E.StickerMessage) ([]byte, error) {
+		return nil, fmt.Errorf("%s: %w", secret, whatsmeow.ErrMediaDownloadFailedWith403)
+	})
+	fixture.wa.favoriteStickerRetries.request = func(context.Context, string, []byte) error { return fmt.Errorf("%s", secret) }
+	if !fixture.wa.handleWAEvent(&events.FavoriteStickerSync{Mutations: []appstate.Mutation{syntheticFavorite([]byte("synthetic"), false)}}) {
+		t.Fatal("deferred batch failed")
+	}
+	if strings.Contains(fixture.logs.String(), secret) || strings.Count(fixture.logs.String(), "Favorite sticker download deferred") != 1 {
+		t.Fatal("secret leaked or failure logged more than once")
+	}
+	var log map[string]json.RawMessage
+	if json.Unmarshal(bytes.TrimSpace(fixture.logs.Bytes()), &log) != nil || log["reupload"] == nil {
+		t.Fatalf("safe diagnostic missing: %s", fixture.logs.String())
+	}
+}
diff --git a/pkg/connector/favorite_stickers.go b/pkg/connector/favorite_stickers.go
new file mode 100644
index 0000000000000000000000000000000000000000..aa2a0c1ae0a363de025da1adb47f5f48e9c83d5c
--- /dev/null
+++ b/pkg/connector/favorite_stickers.go
@@ -0,0 +1,336 @@
+package connector
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"maps"
+	"strings"
+
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waServerSync"
+	"go.mau.fi/whatsmeow/proto/waSyncAction"
+	"go.mau.fi/whatsmeow/types/events"
+	"maunium.net/go/mautrix"
+	"maunium.net/go/mautrix/bridgev2/matrix"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-whatsapp/pkg/msgconv"
+)
+
+const favoriteStickerAccountData = "im.ponies.user_emotes"
+const favoriteStickerMetadata = "fi.mau.whatsapp.favorite"
+
+var ErrFavoriteStickerData = errors.New("invalid favorite sticker data")
+var ErrFavoriteStickerPuppet = errors.New("favorite stickers require a double puppet")
+var ErrFavoriteStickerDownload = errors.New("favorite sticker media pending retry")
+
+type favoriteStickerChange struct {
+	Key       string
+	Hash      []byte
+	Action    *waSyncAction.StickerAction
+	Timestamp int64
+	Remove    bool
+}
+
+type favoriteStickerMedia struct {
+	Data      []byte
+	MimeType  string
+	Name      string
+	Animation []byte
+}
+
+func favoriteStickerPrefix(loginID string) string {
+	sum := sha256.Sum256([]byte(loginID))
+	return "whatsapp_" + hex.EncodeToString(sum[:8]) + "_"
+}
+
+func favoriteStickerMutation(prefix string, mutation appstate.Mutation) (favoriteStickerChange, error) {
+	if len(mutation.Index) != 2 || mutation.Index[0] != appstate.IndexFavoriteSticker {
+		return favoriteStickerChange{}, fmt.Errorf("%w: unexpected index", ErrFavoriteStickerData)
+	}
+	hash, err := base64.StdEncoding.DecodeString(mutation.Index[1])
+	if err != nil || len(hash) != sha256.Size {
+		return favoriteStickerChange{}, fmt.Errorf("%w: invalid file hash", ErrFavoriteStickerData)
+	}
+	change := favoriteStickerChange{Key: prefix + hex.EncodeToString(hash), Hash: hash, Action: mutation.Action.GetStickerAction(), Timestamp: mutation.Action.GetTimestamp()}
+	switch mutation.Operation {
+	case waServerSync.SyncdMutation_REMOVE:
+		change.Remove = true
+	case waServerSync.SyncdMutation_SET:
+		if change.Action == nil {
+			return favoriteStickerChange{}, fmt.Errorf("%w: missing StickerAction", ErrFavoriteStickerData)
+		}
+		change.Remove = !change.Action.GetIsFavorite() || change.Action.GetIsAvatarSticker()
+	default:
+		return favoriteStickerChange{}, fmt.Errorf("%w: unsupported operation", ErrFavoriteStickerData)
+	}
+	return change, nil
+}
+
+func prepareFavoriteSticker(change favoriteStickerChange, data []byte) (favoriteStickerMedia, error) {
+	sum := sha256.Sum256(data)
+	if !bytes.Equal(sum[:], change.Hash) {
+		return favoriteStickerMedia{}, fmt.Errorf("%w: downloaded hash mismatch", ErrFavoriteStickerData)
+	}
+	media := favoriteStickerMedia{Data: data, MimeType: change.Action.GetMimetype(), Name: "sticker.webp"}
+	if change.Action.GetIsLottie() {
+		animation, _, err := msgconv.ExtractAnimatedSticker(data)
+		if err != nil {
+			return favoriteStickerMedia{}, fmt.Errorf("%w: %v", ErrFavoriteStickerData, err)
+		}
+		if !json.Valid(animation) {
+			return favoriteStickerMedia{}, fmt.Errorf("%w: invalid Lottie JSON", ErrFavoriteStickerData)
+		}
+		media.MimeType = "application/was"
+		media.Name = "sticker.was"
+		media.Animation = animation
+	} else if media.MimeType == "" {
+		media.MimeType = "image/webp"
+	}
+	return media, nil
+}
+
+func favoriteStickerEntry(change favoriteStickerChange, media favoriteStickerMedia, original, animation id.ContentURIString) json.RawMessage {
+	info := map[string]any{"mimetype": media.MimeType, "size": len(media.Data), "w": change.Action.GetWidth(), "h": change.Action.GetHeight()}
+	metadata := map[string]any{"file_sha256": hex.EncodeToString(change.Hash), "timestamp": change.Timestamp}
+	if len(media.Animation) > 0 {
+		metadata["animation_url"] = animation
+		metadata["animation_info"] = map[string]any{"mimetype": "video/lottie+json", "size": len(media.Animation), "w": change.Action.GetWidth(), "h": change.Action.GetHeight()}
+	}
+	entry, _ := json.Marshal(map[string]any{"url": original, "body": "WhatsApp sticker", "info": info, "usage": []string{"sticker"}, favoriteStickerMetadata: metadata})
+	return entry
+}
+
+func ownedFavoriteSticker(prefix, key string, entry json.RawMessage) bool {
+	if !strings.HasPrefix(key, prefix) {
+		return false
+	}
+	var value map[string]json.RawMessage
+	if json.Unmarshal(entry, &value) != nil {
+		return false
+	}
+	var metadata struct {
+		Hash string `json:"file_sha256"`
+	}
+	return json.Unmarshal(value[favoriteStickerMetadata], &metadata) == nil && len(metadata.Hash) == 64 && key == prefix+metadata.Hash
+}
+
+type favoriteStickerPack struct {
+	Fields map[string]json.RawMessage
+	Images map[string]json.RawMessage
+}
+
+func readFavoriteStickerPack(ctx context.Context, client *mautrix.Client) (favoriteStickerPack, error) {
+	var fields map[string]json.RawMessage
+	err := client.GetAccountData(ctx, favoriteStickerAccountData, &fields)
+	if err != nil && !errors.Is(err, mautrix.MNotFound) {
+		return favoriteStickerPack{}, fmt.Errorf("read favorite sticker account data: %w", err)
+	}
+	if fields == nil {
+		fields = make(map[string]json.RawMessage)
+	}
+	images := make(map[string]json.RawMessage)
+	if raw, exists := fields["images"]; exists {
+		if string(raw) == "null" {
+			return favoriteStickerPack{}, fmt.Errorf("%w: images is null", ErrFavoriteStickerData)
+		}
+		if err = json.Unmarshal(raw, &images); err != nil {
+			return favoriteStickerPack{}, fmt.Errorf("%w: images: %v", ErrFavoriteStickerData, err)
+		}
+	}
+	return favoriteStickerPack{Fields: fields, Images: images}, nil
+}
+
+func mergeFavoriteStickerPack(current favoriteStickerPack, prefix string, changes map[string]json.RawMessage, fullSync bool) (map[string]json.RawMessage, error) {
+	fields := maps.Clone(current.Fields)
+	images := maps.Clone(current.Images)
+	for key, entry := range images {
+		if ownedFavoriteSticker(prefix, key, entry) {
+			if _, exists := changes[key]; fullSync && !exists {
+				delete(images, key)
+			}
+		}
+	}
+	for key, entry := range changes {
+		if previous, exists := images[key]; exists && !ownedFavoriteSticker(prefix, key, previous) {
+			return nil, fmt.Errorf("%w: shortcode collision", ErrFavoriteStickerData)
+		}
+		if entry == nil {
+			delete(images, key)
+		} else {
+			images[key] = entry
+		}
+	}
+	var pack map[string]json.RawMessage
+	if raw, exists := fields["pack"]; exists {
+		if err := json.Unmarshal(raw, &pack); err != nil || pack == nil {
+			return nil, fmt.Errorf("%w: malformed pack", ErrFavoriteStickerData)
+		}
+	} else {
+		pack = make(map[string]json.RawMessage)
+	}
+	if _, exists := pack["display_name"]; !exists {
+		pack["display_name"] = json.RawMessage(`"WhatsApp"`)
+	}
+	if _, exists := pack["usage"]; !exists && len(current.Images) == 0 {
+		pack["usage"] = json.RawMessage(`["sticker"]`)
+	}
+	fields["pack"], _ = json.Marshal(pack)
+	fields["images"], _ = json.Marshal(images)
+	return fields, nil
+}
+
+type favoriteStickerDownloader func(context.Context, *waE2E.StickerMessage) ([]byte, error)
+
+func syncFavoriteStickers(ctx context.Context, client *mautrix.Client, prefix string, batch *events.FavoriteStickerSync, download favoriteStickerDownloader) error {
+	changes := make(map[string]favoriteStickerChange, len(batch.Mutations))
+	order := make([]string, 0, len(batch.Mutations))
+	for _, mutation := range batch.Mutations {
+		change, err := favoriteStickerMutation(prefix, mutation)
+		if err != nil {
+			return err
+		}
+		if _, exists := changes[change.Key]; !exists {
+			order = append(order, change.Key)
+		}
+		changes[change.Key] = change
+	}
+	current, err := readFavoriteStickerPack(ctx, client)
+	if err != nil {
+		return err
+	}
+	if _, err = mergeFavoriteStickerPack(current, prefix, nil, false); err != nil {
+		return err
+	}
+	for key := range changes {
+		if previous, exists := current.Images[key]; exists && !ownedFavoriteSticker(prefix, key, previous) {
+			return fmt.Errorf("%w: shortcode collision", ErrFavoriteStickerData)
+		}
+	}
+	entries := make(map[string]json.RawMessage, len(changes))
+	var mediaErr error
+	for _, key := range order {
+		change := changes[key]
+		if change.Remove {
+			entries[key] = nil
+			continue
+		}
+		if previous, exists := current.Images[key]; exists && ownedFavoriteSticker(prefix, key, previous) {
+			var entry map[string]json.RawMessage
+			var metadata map[string]json.RawMessage
+			_ = json.Unmarshal(previous, &entry)
+			_ = json.Unmarshal(entry[favoriteStickerMetadata], &metadata)
+			metadata["timestamp"], _ = json.Marshal(change.Timestamp)
+			entry[favoriteStickerMetadata], _ = json.Marshal(metadata)
+			entries[key], _ = json.Marshal(entry)
+			continue
+		}
+		action := change.Action
+		data, downloadErr := download(ctx, &waE2E.StickerMessage{URL: action.URL, DirectPath: action.DirectPath, MediaKey: action.MediaKey, FileSHA256: change.Hash, FileEncSHA256: action.FileEncSHA256, FileLength: action.FileLength, Mimetype: action.Mimetype})
+		if downloadErr != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			mediaErr = ErrFavoriteStickerDownload
+			continue
+		}
+		media, prepareErr := prepareFavoriteSticker(change, data)
+		if prepareErr != nil {
+			return prepareErr
+		}
+		original, uploadErr := client.UploadBytesWithName(ctx, media.Data, media.MimeType, media.Name)
+		if uploadErr != nil {
+			return fmt.Errorf("upload favorite sticker: %w", uploadErr)
+		}
+		var animation id.ContentURIString
+		if len(media.Animation) > 0 {
+			uploaded, animationErr := client.UploadBytesWithName(ctx, media.Animation, "video/lottie+json", "sticker.json")
+			if animationErr != nil {
+				return fmt.Errorf("upload favorite animation: %w", animationErr)
+			}
+			animation = uploaded.ContentURI.CUString()
+		}
+		entries[key] = favoriteStickerEntry(change, media, original.ContentURI.CUString(), animation)
+	}
+	if len(entries) == 0 && !batch.FromFullSync {
+		return mediaErr
+	}
+	current, err = readFavoriteStickerPack(ctx, client)
+	if err != nil {
+		return err
+	}
+	merged, err := mergeFavoriteStickerPack(current, prefix, entries, batch.FromFullSync)
+	if err != nil {
+		return err
+	}
+	before, _ := json.Marshal(current.Fields)
+	after, _ := json.Marshal(merged)
+	if string(before) == string(after) {
+		return mediaErr
+	}
+	if err = client.SetAccountData(ctx, favoriteStickerAccountData, merged); err != nil {
+		return fmt.Errorf("publish favorite sticker pack: %w", err)
+	}
+	return mediaErr
+}
+
+func (wa *WhatsAppClient) handleFavoriteStickerSync(ctx context.Context, batch *events.FavoriteStickerSync) bool {
+	wa.Main.favoriteStickerLock.Lock(wa.UserLogin.User.MXID)
+	defer wa.Main.favoriteStickerLock.Unlock(wa.UserLogin.User.MXID)
+	return wa.publishFavoriteStickerSync(ctx, batch)
+}
+
+func (wa *WhatsAppClient) publishFavoriteStickerSync(ctx context.Context, batch *events.FavoriteStickerSync) bool {
+	if ctx.Err() != nil {
+		return false
+	}
+	wa.initFavoriteStickerRetries(ctx)
+	if wa.favoriteStickerRetries.paused {
+		return false
+	}
+	if err := wa.favoriteStickerRetries.reconcile(favoriteStickerPrefix(string(wa.UserLogin.ID)), batch); err != nil {
+		wa.UserLogin.Log.Err(err).Msg("Invalid favorite sticker batch")
+		return false
+	}
+	defer func() { wa.favoriteStickerRetries.changes = nil }()
+	defer wa.scheduleFavoriteStickerRetries(ctx)
+	puppet, ok := wa.UserLogin.User.DoublePuppet(ctx).(*matrix.ASIntent)
+	if !ok || !puppet.IsDoublePuppet() {
+		wa.UserLogin.Log.Error().Err(ErrFavoriteStickerPuppet).Msg("Cannot publish favorite stickers")
+		return false
+	}
+	succeeded := make(map[string]bool)
+	err := syncFavoriteStickers(ctx, puppet.Matrix.Client, favoriteStickerPrefix(string(wa.UserLogin.ID)), batch, wa.favoriteStickerDownload(ctx, succeeded))
+	if err != nil && !errors.Is(err, ErrFavoriteStickerDownload) {
+		wa.UserLogin.Log.Err(err).Msg("Failed to publish favorite stickers")
+		return false
+	}
+	for key := range succeeded {
+		delete(wa.favoriteStickerRetries.pending, key)
+	}
+	if batch.FromFullSync {
+		wa.favoriteStickerSnapshotSeen.Store(true)
+	}
+	return true
+}
+
+func (wa *WhatsAppClient) ensureFavoriteStickerSnapshot(ctx context.Context) {
+	if !wa.favoriteStickerSnapshotRequested.CompareAndSwap(false, true) || wa.favoriteStickerSnapshotSeen.Load() {
+		return
+	}
+	go func() {
+		if err := wa.Client.FetchAppState(ctx, appstate.WAPatchRegularLow, true, false); err != nil {
+			wa.favoriteStickerSnapshotRequested.Store(false)
+			wa.UserLogin.Log.Err(err).Msg("Failed to fetch initial favorite sticker snapshot")
+		} else if !wa.favoriteStickerSnapshotSeen.Load() {
+			wa.favoriteStickerSnapshotRequested.Store(false)
+		}
+	}()
+}

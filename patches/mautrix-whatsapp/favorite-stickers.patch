+	}
+	fixture.wa.Main.favoriteStickerLock.Lock(fixture.wa.UserLogin.User.MXID)
+	defer fixture.wa.Main.favoriteStickerLock.Unlock(fixture.wa.UserLogin.User.MXID)
+	if attempts != 2 || len(syntheticImages(t, fixture.matrix)) != 2 || len(state.pending) != 0 || state.timer != nil {
+		t.Fatal("real timer lost publication or kept retrying")
+	}

+func TestFavoriteRealTimerPublishesWithoutNewEvent(t *testing.T) {
+	data := []byte("synthetic real timer recovery")
+	attempts := 0
+	uploaded := make(chan struct{}, 1)
+	fixture := newFavoriteRetryFixture(t, func(context.Context, *waE2E.StickerMessage) ([]byte, error) {
+		attempts++
+		if attempts == 1 {
+			return nil, whatsmeow.ErrMediaDownloadFailedWith403
+		}
+		return data, nil
+	})
+	fixture.matrix.onUpload = func(map[string]json.RawMessage) { uploaded <- struct{}{} }
+	if !fixture.wa.handleWAEvent(&events.FavoriteStickerSync{Mutations: []appstate.Mutation{syntheticFavorite(data, false)}}) {
+		t.Fatal("initial defer failed")
+	}
+	fixture.wa.Main.favoriteStickerLock.Lock(fixture.wa.UserLogin.User.MXID)
+	state := fixture.wa.favoriteStickerRetries
+	state.now = time.Now
+	state.afterFunc = time.AfterFunc
+	for _, pending := range state.pending {
+		pending.next = time.Now()
+	}
+	fixture.wa.scheduleFavoriteStickerRetries(fixture.wa.Main.Bridge.BackgroundCtx)
+	fixture.wa.Main.favoriteStickerLock.Unlock(fixture.wa.UserLogin.User.MXID)
+	select {
+	case <-uploaded:
+	case <-time.After(4 * time.Second):

+package connector
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func TestFavoriteForbiddenDoesNotBlockBatch(t *testing.T) {
+	state, client := newSyntheticFavoriteServer(t)
+	prefix := favoriteStickerPrefix("synthetic-login")
+	bad, first, second := []byte("expired synthetic"), []byte("good synthetic one"), []byte("good synthetic two")
+	mutations := []appstate.Mutation{syntheticFavorite(bad, false), syntheticFavorite(first, false), syntheticFavorite(second, false)}
+	_ = syncFavoriteStickers(context.Background(), client, prefix, &events.FavoriteStickerSync{FromFullSync: true, Mutations: mutations}, func(_ context.Context, msg *waE2E.StickerMessage) ([]byte, error) {
+		if bytes.Equal(msg.FileSHA256, sha256Bytes(bad)) {
+			return nil, whatsmeow.ErrMediaDownloadFailedWith403
+		}
+		if bytes.Equal(msg.FileSHA256, sha256Bytes(first)) {
+			return first, nil
+		}
+		return second, nil
+	})
+	images := syntheticImages(t, state)
+	for _, mutation := range mutations[1:] {
+		change, _ := favoriteStickerMutation(prefix, mutation)
+		if !ownedFavoriteSticker(prefix, change.Key, images[change.Key]) {
+			t.Fatal("one 403 blocked an available favorite")
+		}
+	}
+	if len(images) != 3 || state.writes != 1 || len(state.uploads) != 2 {
+		t.Fatal("partial publication lost foreign data or uploaded failed media")
+	}
+}

+func syntheticFavorite(data []byte, lottie bool) appstate.Mutation {
+	hash := sha256.Sum256(data)
+	return appstate.Mutation{Operation: waServerSync.SyncdMutation_SET, Index: []string{appstate.IndexFavoriteSticker, base64.StdEncoding.EncodeToString(hash[:])}, Action: &waSyncAction.SyncActionValue{Timestamp: proto.Int64(100), StickerAction: &waSyncAction.StickerAction{IsFavorite: proto.Bool(true), IsLottie: proto.Bool(lottie), Width: proto.Uint32(512), Height: proto.Uint32(512), Mimetype: proto.String("image/webp"), DirectPath: proto.String("/synthetic"), MediaKey: bytes.Repeat([]byte{1}, 32), FileEncSHA256: bytes.Repeat([]byte{2}, 32)}}}
+}

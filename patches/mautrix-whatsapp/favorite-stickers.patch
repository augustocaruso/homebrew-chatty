+func TestFavoriteHandlerDoesNotLogMediaSecrets(t *testing.T) {
+	const marker = "SYNTHETIC_HANDLER_PRIVATE_QUERY"
+	state, client := newSyntheticFavoriteServer(t)
+	var logs bytes.Buffer
+	logger := zerolog.New(&logs).Level(zerolog.TraceLevel)
+	service, err := appservice.CreateFull(appservice.CreateOpts{Registration: &appservice.Registration{SenderLocalpart: "synthetic-bot"}, HomeserverDomain: "example.invalid", HomeserverURL: client.HomeserverURL.String()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	service.DoublePuppetValue = "synthetic-whatsapp"
+	puppet := service.NewIntentAPI("synthetic")
+	puppet.Client = client
+	puppet.IsCustomPuppet = true
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	bridge := &bridgev2.Bridge{BackgroundCtx: ctx, Matrix: &syntheticFavoriteMatrix{intent: &matrix.ASIntent{Matrix: puppet}}}
+	login := &bridgev2.UserLogin{UserLogin: &database.UserLogin{ID: "synthetic-login"}, Log: logger}
+	login.User = &bridgev2.User{User: &database.User{MXID: client.UserID, AccessToken: "synthetic-token"}, Bridge: bridge, Log: logger}
+	wa := &WhatsAppClient{Main: &WhatsAppConnector{Bridge: bridge}, UserLogin: login, MC: noopMCInstance, Client: whatsmeow.NewClient(&store.Device{}, waLog.Zerolog(logger))}
+	mutation := syntheticFavorite([]byte("synthetic original"), false)
+	mutation.Action.StickerAction.DirectPath = proto.String("invalid?token=" + marker)
+	if !wa.handleWAEvent(&events.FavoriteStickerSync{Mutations: []appstate.Mutation{mutation}}) {
+		t.Fatal("failed media kept the whole batch in the whatsmeow queue")
+	}
+	if strings.Contains(logs.String(), marker) {
+		t.Fatal("real bridge handler leaked media query in logs")
+	}
+	if !strings.Contains(logs.String(), "error_type") || !strings.Contains(logs.String(), "Favorite sticker download deferred") {
+		t.Fatal("sanitized media failure diagnostic was hidden")
+	}
+	if state.writes != 0 || len(state.uploads) != 0 {
+		t.Fatal("failed download caused a Matrix effect")
+	}
+}
+
+type favoritePipelineStore struct {
+	store.NoopStore
+	mu    sync.Mutex
+	state appstate.HashState
+	macs  map[string][]byte
+}
+
+func (s *favoritePipelineStore) GetAppStateSyncKey(context.Context, []byte) (*store.AppStateSyncKey, error) {
+	return &store.AppStateSyncKey{Data: bytes.Repeat([]byte{7}, 32)}, nil
+}
+func (s *favoritePipelineStore) PutAppStateVersion(_ context.Context, _ string, version uint64, hash [128]byte) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.state = appstate.HashState{Version: version, Hash: hash}
+	return nil
+}
+func (s *favoritePipelineStore) GetAppStateVersion(context.Context, string) (uint64, [128]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.state.Version, s.state.Hash, nil
+}
+func (s *favoritePipelineStore) GetAppStateMutationMAC(_ context.Context, _ string, index []byte) ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.macs[string(index)], nil
+}
+func (s *favoritePipelineStore) PutAppStateMutationMACs(_ context.Context, _ string, _ uint64, macs []store.AppStateMutationMAC) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, mac := range macs {
+		s.macs[string(mac.IndexMAC)] = mac.ValueMAC
+	}
+	return nil
+}
+func (s *favoritePipelineStore) DeleteAppStateMutationMACs(_ context.Context, _ string, indexes [][]byte) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, index := range indexes {
+		delete(s.macs, string(index))
+	}
+	return nil
+}
+
+func applySyntheticFavoriteDelta(t *testing.T, cli *whatsmeow.Client, mutation appstate.Mutation) {
+	t.Helper()
+	ctx := cli.BackgroundEventCtx
+	version, hash, err := cli.Store.AppState.GetAppStateVersion(ctx, "regular_low")
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := appstate.HashState{Version: version, Hash: hash}
+	encoder := appstate.NewProcessor(cli.Store, waLog.Noop)
+	raw, err := encoder.EncodePatch(ctx, []byte{1}, state, appstate.PatchInfo{Type: appstate.WAPatchRegularLow, Timestamp: time.UnixMilli(100), Mutations: []appstate.MutationInfo{{Index: mutation.Index, Version: 1, Value: mutation.Action}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	patch := &waServerSync.SyncdPatch{}
+	if err = proto.Unmarshal(raw, patch); err != nil {
+		t.Fatal(err)
+	}
+	patch.Version = &waServerSync.SyncdVersion{Version: proto.Uint64(version + 1)}
+	var collected []any
+	if _, err = cli.DangerousInternals().ApplyAppStatePatches(ctx, appstate.WAPatchRegularLow, state, &appstate.PatchList{Name: appstate.WAPatchRegularLow, Patches: []*waServerSync.SyncdPatch{patch}}, false, &collected); err != nil {
+		t.Fatal(err)
+	}
+	for _, event := range collected {
+		cli.DangerousInternals().DispatchEvent(event)
+	}
+}
+
+func awaitFavoritePipeline(t *testing.T, ch <-chan struct{}, reason string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(4 * time.Second):
+		t.Fatal(reason)
+	}
+}
+
+func TestFavoritePipelineRetriesMatrixFailures(t *testing.T) {
+	for _, scenario := range []string{"read", "download", "original_upload", "animation_upload", "put", "remove_put"} {
+		t.Run(scenario, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			state, matrixClient := newSyntheticFavoriteServer(t)
+			prefix := favoriteStickerPrefix("synthetic-login")
+			initial := []byte("initial successful snapshot")
+			starter := syntheticFavorite(initial, false)
+			if err := syncFavoriteStickers(ctx, matrixClient, prefix, &events.FavoriteStickerSync{FromFullSync: true, Mutations: []appstate.Mutation{starter}}, func(context.Context, *waE2E.StickerMessage) ([]byte, error) { return initial, nil }); err != nil {
+				t.Fatal(err)
+			}
+			data := []byte("new favorite after successful initial snapshot")
+			if scenario == "animation_upload" {
+				var err error
+				data, err = msgconv.PackAnimatedSticker([]byte(`{"v":"5.7.4","fr":30,"ip":0,"op":30,"w":512,"h":512,"layers":[]}`))
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			mutation := syntheticFavorite(data, scenario == "animation_upload")
+			if scenario == "remove_put" {
+				mutation = starter
+				mutation.Action.StickerAction.IsFavorite = proto.Bool(false)
+			}
+			change, err := favoriteStickerMutation(prefix, mutation)
+			if err != nil {
+				t.Fatal(err)
+			}
+			state.mu.Lock()
+			beforeWrites := state.writes
+			switch scenario {
+			case "read":
+				state.readError = 403
+			case "original_upload":
+				state.uploadError = 500
+			case "animation_upload":
+				state.uploadError = 500
+				state.uploadErrorAt = state.uploadCalls + 2
+			case "put", "remove_put":
+				state.writeError = 403
+			}
+			state.mu.Unlock()
+			var recovered atomic.Bool
+			var downloads atomic.Int32
+			memory := &favoritePipelineStore{macs: make(map[string][]byte)}
+			cli := whatsmeow.NewClient(&store.Device{AppState: memory, AppStateKeys: memory}, waLog.Noop)
+			cli.EmitFavoriteStickerEvents = true
+			cli.BackgroundEventCtx = ctx
+			failed, published := make(chan struct{}, 8), make(chan struct{}, 8)
+			cli.AddEventHandlerWithSuccessStatus(func(raw any) bool {
+				batch, ok := raw.(*events.FavoriteStickerSync)
+				if !ok {
+					return true
+				}
+				err := syncFavoriteStickers(ctx, matrixClient, prefix, batch, func(context.Context, *waE2E.StickerMessage) ([]byte, error) {
+					downloads.Add(1)
+					if scenario == "download" && !recovered.Load() {
+						return nil, errors.New("synthetic network outage")
+					}
+					return data, nil
+				})
+				if err != nil {
+					failed <- struct{}{}
+					return false
+				}
+				published <- struct{}{}
+				return true
+			})
+			applySyntheticFavoriteDelta(t, cli, mutation)
+			awaitFavoritePipeline(t, failed, "Matrix failure was not exercised through decode/dispatch")
+			state.mu.Lock()
+			if state.writes != beforeWrites {
+				state.mu.Unlock()
+				t.Fatal("failed effect published a partial pack")
+			}
+			state.readError = 0
+			state.uploadError = 0
+			state.uploadErrorAt = 0
+			state.writeError = 0
+			state.mu.Unlock()
+			beforeVersion, beforeHash, _ := memory.GetAppStateVersion(ctx, "regular_low")
+			recovered.Store(true)
+			awaitFavoritePipeline(t, published, "lost Matrix/media effect after app-state version advance")
+			images := syntheticImages(t, state)
+			if images["other_client"] == nil {
+				t.Fatal("retry removed third-party sticker")
+			}
+			if scenario == "remove_put" {
+				if images[change.Key] != nil {
+					t.Fatal("unfavorite was not recovered")
+				}
+			} else if !ownedFavoriteSticker(prefix, change.Key, images[change.Key]) {
+				t.Fatal("favorite was not recovered")
+			}
+			afterVersion, afterHash, _ := memory.GetAppStateVersion(ctx, "regular_low")
+			if beforeVersion != afterVersion || beforeHash != afterHash {
+				t.Fatal("retry rewound or advanced app-state cryptography")
+			}
+			state.mu.Lock()
+			writes, uploads := state.writes, len(state.uploads)
+			state.mu.Unlock()
+			downloadCount := downloads.Load()
+			applySyntheticFavoriteDelta(t, cli, mutation)
+			awaitFavoritePipeline(t, published, "repeated delta was not delivered")
+			state.mu.Lock()
+			defer state.mu.Unlock()
+			if state.writes != writes || len(state.uploads) != uploads || downloads.Load() != downloadCount {
+				t.Fatal("repeated recovered delta was not idempotent")
+			}
+			if !json.Valid(state.content["images"]) {
+				t.Fatal("retry published invalid account data")
+			}
+		})
+	}
+}
diff --git a/pkg/connector/favorite_retry.go b/pkg/connector/favorite_retry.go
new file mode 100644
index 0000000000000000000000000000000000000000..4c247f0454756f14b9f1542bf439999dcedc1052
--- /dev/null
+++ b/pkg/connector/favorite_retry.go
@@ -0,0 +1,273 @@
+package connector
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waMmsRetry"
+	"go.mau.fi/whatsmeow/proto/waSyncAction"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+// Política local conservadora: não repetir mídia expirada a cada lote/30s.
+// README.md documenta 1min dobrando até 1h; remova o estado ao desfavoritar.
+const favoriteStickerRetryInitial = time.Minute
+const favoriteStickerRetryMaximum = time.Hour
+
+type favoriteStickerRetry struct {
+	mutation  appstate.Mutation
+	delay     time.Duration
+	next      time.Time
+	requestID string
+	media     *waE2E.StickerMessage
+}
+
+type favoriteStickerRetryState struct {
+	pending    map[string]*favoriteStickerRetry
+	changes    map[string]appstate.Mutation
+	timer      *time.Timer
+	generation uint64
+	paused     bool
+	now        func() time.Time
+	afterFunc  func(time.Duration, func()) *time.Timer
+	download   favoriteStickerDownloader
+	request    func(context.Context, string, []byte) error
+	nextID     func() string
+}
+
+func (wa *WhatsAppClient) initFavoriteStickerRetries(ctx context.Context) {
+	if wa.favoriteStickerRetries != nil {
+		return
+	}
+	state := &favoriteStickerRetryState{pending: make(map[string]*favoriteStickerRetry), now: time.Now, afterFunc: time.AfterFunc,
+		download: func(ctx context.Context, msg *waE2E.StickerMessage) ([]byte, error) {
+			return wa.Client.Download(ctx, msg)
+		},
+		request: wa.requestFavoriteStickerReupload, nextID: func() string { return wa.Client.GenerateMessageID() },
+	}
+	wa.favoriteStickerRetries = state
+	context.AfterFunc(ctx, func() {
+		wa.Main.favoriteStickerLock.Lock(wa.UserLogin.User.MXID)
+		defer wa.Main.favoriteStickerLock.Unlock(wa.UserLogin.User.MXID)
+		if state.timer != nil {
+			state.timer.Stop()
+		}
+		state.generation++
+		clear(state.pending)
+	})
+}
+
+func (state *favoriteStickerRetryState) reconcile(prefix string, batch *events.FavoriteStickerSync) error {
+	changes := make(map[string]appstate.Mutation, len(batch.Mutations))
+	for _, mutation := range batch.Mutations {
+		change, err := favoriteStickerMutation(prefix, mutation)
+		if err != nil {
+			return err
+		}
+		changes[change.Key] = mutation
+	}
+	for key := range state.pending {
+		mutation, present := changes[key]
+		if !present {
+			if batch.FromFullSync {
+				delete(state.pending, key)
+			}
+			continue
+		}
+		change, _ := favoriteStickerMutation(prefix, mutation)
+		if change.Remove {
+			delete(state.pending, key)
+		} else {
+			if !proto.Equal(state.pending[key].mutation.Action.GetStickerAction(), mutation.Action.GetStickerAction()) {
+				state.pending[key].media = nil
+				state.pending[key].requestID = ""
+			}
+			state.pending[key].mutation = cloneFavoriteMutation(mutation)
+		}
+	}
+	state.changes = changes
+	return nil
+}
+
+func cloneFavoriteMutation(mutation appstate.Mutation) appstate.Mutation {
+	mutation.Index = append([]string(nil), mutation.Index...)
+	if mutation.Action != nil {
+		mutation.Action = proto.Clone(mutation.Action).(*waSyncAction.SyncActionValue)
+	}
+	return mutation
+}
+
+func (wa *WhatsAppClient) favoriteStickerDownload(ctx context.Context, succeeded map[string]bool) favoriteStickerDownloader {
+	state := wa.favoriteStickerRetries
+	prefix := favoriteStickerPrefix(string(wa.UserLogin.ID))
+	for key := range state.changes {
+		succeeded[key] = true
+	}
+	return func(_ context.Context, message *waE2E.StickerMessage) ([]byte, error) {
+		key := prefix + hex.EncodeToString(message.FileSHA256)
+		pending := state.pending[key]
+		if pending != nil && state.now().Before(pending.next) {
+			delete(succeeded, key)
+			return nil, ErrFavoriteStickerDownload
+		}
+		if pending != nil {
+			pending.next = state.now().Add(favoriteStickerRetryInitial)
+			if pending.media != nil {
+				message = pending.media
+			}
+		}
+		data, err := state.download(ctx, message)
+		if err == nil {
+			return data, nil
+		}
+		delete(succeeded, key)
+		if pending == nil {
+			pending = &favoriteStickerRetry{mutation: cloneFavoriteMutation(state.changes[key])}
+			state.pending[key] = pending
+		}
+		pending.delay = min(max(pending.delay*2, favoriteStickerRetryInitial), favoriteStickerRetryMaximum)
+		pending.next = state.now().Add(pending.delay)
+		pending.requestID = ""
+		// Nunca serializar Error() externo: URL, query e chaves podem estar nele.
+		log := wa.UserLogin.Log.Warn().Str("sticker", key).Dur("retry_in", pending.delay).Str("error_type", fmt.Sprintf("%T", err))
+		var httpErr whatsmeow.DownloadHTTPError
+		if errors.As(err, &httpErr) {
+			log.Int("status_code", httpErr.StatusCode)
+		}
+
+		if errors.Is(err, whatsmeow.ErrMediaDownloadFailedWith403) || errors.Is(err, whatsmeow.ErrMediaDownloadFailedWith404) || errors.Is(err, whatsmeow.ErrMediaDownloadFailedWith410) {
+			pending.requestID = state.nextID()
+			requestCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
+			requestErr := state.request(requestCtx, pending.requestID, message.FileSHA256)
+			cancel()
+			if requestErr != nil {
+				pending.requestID = ""
+				log.Str("reupload", "unavailable")
+			} else {
+				log.Str("reupload", "requested")
+			}
+		}
+		log.Msg("Favorite sticker download deferred")
+		return nil, ErrFavoriteStickerDownload
+	}
+}
+
+func (wa *WhatsAppClient) scheduleFavoriteStickerRetries(ctx context.Context) {
+	state := wa.favoriteStickerRetries
+	if state.timer != nil {
+		state.timer.Stop()
+		state.timer = nil
+	}
+	state.generation++
+	generation := state.generation
+	if ctx.Err() != nil || state.paused || len(state.pending) == 0 {
+		return
+	}
+	var next time.Time
+	for _, pending := range state.pending {
+		if next.IsZero() || pending.next.Before(next) {
+			next = pending.next
+		}
+	}
+	state.timer = state.afterFunc(max(next.Sub(state.now()), 0), func() {
+		wa.Main.favoriteStickerLock.Lock(wa.UserLogin.User.MXID)
+		defer wa.Main.favoriteStickerLock.Unlock(wa.UserLogin.User.MXID)
+		if ctx.Err() != nil || state.paused || state.generation != generation {
+			return
+		}
+		batch := &events.FavoriteStickerSync{}
+		for _, pending := range state.pending {
+			if !state.now().Before(pending.next) {
+				batch.Mutations = append(batch.Mutations, cloneFavoriteMutation(pending.mutation))
+			}
+		}
+		success := wa.publishFavoriteStickerSync(ctx, batch)
+		if !success {
+			for _, pending := range state.pending {
+				if !state.now().Before(pending.next) {
+					pending.next = state.now().Add(favoriteStickerRetryInitial)
+				}
+			}
+			wa.scheduleFavoriteStickerRetries(ctx)
+		}
+	})
+}
+
+func (wa *WhatsAppClient) pauseFavoriteStickerRetries() {
+	wa.Main.favoriteStickerLock.Lock(wa.UserLogin.User.MXID)
+	defer wa.Main.favoriteStickerLock.Unlock(wa.UserLogin.User.MXID)
+	wa.initFavoriteStickerRetries(wa.Main.Bridge.BackgroundCtx)
+	state := wa.favoriteStickerRetries
+	state.paused = true
+	state.generation++
+	if state.timer != nil {
+		state.timer.Stop()
+		state.timer = nil
+	}
+}
+
+func (wa *WhatsAppClient) resumeFavoriteStickerRetries(ctx context.Context) {
+	wa.Main.favoriteStickerLock.Lock(wa.UserLogin.User.MXID)
+	defer wa.Main.favoriteStickerLock.Unlock(wa.UserLogin.User.MXID)
+	if state := wa.favoriteStickerRetries; state != nil {
+		state.paused = false
+		wa.scheduleFavoriteStickerRetries(ctx)
+	}
+}
+
+func favoriteStickerReuploadRequest(hash []byte) *waE2E.Message {
+	return &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{
+		Type: waE2E.ProtocolMessage_PEER_DATA_OPERATION_REQUEST_MESSAGE.Enum(),
+		PeerDataOperationRequestMessage: &waE2E.PeerDataOperationRequestMessage{
+			PeerDataOperationRequestType: waE2E.PeerDataOperationRequestType_UPLOAD_STICKER.Enum(),
+			RequestStickerReupload:       []*waE2E.PeerDataOperationRequestMessage_RequestStickerReupload{{FileSHA256: proto.String(base64.StdEncoding.EncodeToString(hash))}},
+		},
+	}}
+}
+
+func (wa *WhatsAppClient) requestFavoriteStickerReupload(ctx context.Context, requestID string, hash []byte) error {
+	_, err := wa.Client.SendMessage(ctx, wa.JID.ToNonAD(), favoriteStickerReuploadRequest(hash), whatsmeow.SendRequestExtra{ID: requestID, Peer: true})
+	return err
+}
+
+func (wa *WhatsAppClient) handleFavoriteStickerReupload(ctx context.Context, evt *events.Message) bool {
+	response := evt.Message.GetProtocolMessage().GetPeerDataOperationRequestResponseMessage()
+	if evt.Message.GetProtocolMessage().GetType() != waE2E.ProtocolMessage_PEER_DATA_OPERATION_REQUEST_RESPONSE_MESSAGE || response == nil || response.PeerDataOperationRequestType == nil || response.GetPeerDataOperationRequestType() != waE2E.PeerDataOperationRequestType_UPLOAD_STICKER {
+		return false
+	}
+	if !evt.Info.IsFromMe || evt.Info.Sender.Device != 0 || (evt.Info.Sender.ToNonAD() != wa.JID.ToNonAD() && evt.Info.Sender.ToNonAD() != wa.LID.ToNonAD()) {
+		return true
+	}
+	wa.Main.favoriteStickerLock.Lock(wa.UserLogin.User.MXID)
+	defer wa.Main.favoriteStickerLock.Unlock(wa.UserLogin.User.MXID)
+	state := wa.favoriteStickerRetries
+	if state == nil || ctx.Err() != nil {
+		return true
+	}
+	for _, pending := range state.pending {
+		if pending.requestID == "" || pending.requestID != response.GetStanzaID() {
+			continue
+		}
+		change, _ := favoriteStickerMutation(favoriteStickerPrefix(string(wa.UserLogin.ID)), pending.mutation)
+		for _, result := range response.GetPeerDataOperationResult() {
+			message := result.GetStickerMessage()
+			if result.MediaUploadResult == nil || result.GetMediaUploadResult() != waMmsRetry.MediaRetryNotification_SUCCESS || message == nil || !bytes.Equal(message.FileSHA256, change.Hash) || message.GetDirectPath() == "" {
+				continue
+			}
+			pending.media = proto.Clone(message).(*waE2E.StickerMessage)
+			pending.requestID = ""
+			// Mantém a janela de backoff mesmo com respostas/replays imediatos.
+			break
+		}
+	}
+	return true
+}

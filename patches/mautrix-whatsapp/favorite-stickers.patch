+func TestFavoriteStickerFailuresDoNotPublish(t *testing.T) {
+	for _, scenario := range []string{"read", "upload", "download", "hash", "lottie", "malformed_images", "malformed_pack", "missing_action", "bad_hash", "collision"} {
+		t.Run(scenario, func(t *testing.T) {
+			state, client := newSyntheticFavoriteServer(t)
+			data := []byte("synthetic original")
+			mutation := syntheticFavorite(data, false)
+			prefix := favoriteStickerPrefix("synthetic-login")
+			download := func(context.Context, *waE2E.StickerMessage) ([]byte, error) {
+				if scenario == "download" {
+					return nil, errors.New("synthetic download failure")
+				}
+				if scenario == "hash" {
+					return []byte("wrong"), nil
+				}
+				return data, nil
+			}
+			switch scenario {
+			case "read":
+				state.readError = 403
+			case "upload":
+				state.uploadError = 500
+			case "lottie":
+				mutation.Action.StickerAction.IsLottie = proto.Bool(true)
+			case "malformed_images":
+				state.content["images"] = json.RawMessage(`[]`)
+			case "malformed_pack":
+				state.content["pack"] = json.RawMessage(`[]`)
+			case "missing_action":
+				mutation.Action = nil
+			case "bad_hash":
+				mutation.Index[1] = "bad"
+			case "collision":
+				change, _ := favoriteStickerMutation(prefix, mutation)
+				state.content["images"] = json.RawMessage(fmt.Sprintf(`{"%s":{"url":"mxc://synthetic/foreign"}}`, change.Key))
+			}
+			err := syncFavoriteStickers(context.Background(), client, prefix, &events.FavoriteStickerSync{Mutations: []appstate.Mutation{mutation}}, download)
+			if err == nil || state.writes != 0 {
+				t.Fatalf("failure published: error=%v writes=%d", err, state.writes)
+			}
+		})
+	}

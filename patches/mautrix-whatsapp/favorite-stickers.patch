+}
+
+func newFavoriteRetryFixture(t *testing.T, download favoriteStickerDownloader) *favoriteRetryFixture {
+	t.Helper()
+	state, client := newSyntheticFavoriteServer(t)
+	fixture := &favoriteRetryFixture{matrix: state, now: time.Unix(1000, 0)}
+	logger := zerolog.New(&fixture.logs).Level(zerolog.WarnLevel)
+	service, err := appservice.CreateFull(appservice.CreateOpts{Registration: &appservice.Registration{SenderLocalpart: "synthetic-bot"}, HomeserverDomain: "example.invalid", HomeserverURL: client.HomeserverURL.String()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	service.DoublePuppetValue = "synthetic-whatsapp"
+	puppet := service.NewIntentAPI("synthetic")
+	puppet.Client = client
+	puppet.IsCustomPuppet = true
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	bridge := &bridgev2.Bridge{BackgroundCtx: ctx, Matrix: &syntheticFavoriteMatrix{intent: &matrix.ASIntent{Matrix: puppet}}}
+	login := &bridgev2.UserLogin{UserLogin: &database.UserLogin{ID: "synthetic-login"}, Log: logger}
+	login.User = &bridgev2.User{User: &database.User{MXID: client.UserID, AccessToken: "synthetic-token"}, Bridge: bridge, Log: logger}
+	fixture.wa = &WhatsAppClient{Main: &WhatsAppConnector{Bridge: bridge}, UserLogin: login, MC: noopMCInstance, JID: types.NewJID("123", types.DefaultUserServer)}
+	fixture.wa.favoriteStickerRetries = &favoriteStickerRetryState{
+		pending: make(map[string]*favoriteStickerRetry), now: func() time.Time { return fixture.now },
+		afterFunc: func(delay time.Duration, fire func()) *time.Timer {
+			fixture.delay = delay
+			fixture.fire = fire
+			return nil
+		},
+		download: download, nextID: func() string { return fmt.Sprintf("synthetic-request-%d", fixture.requests+1) },
+		request: func(_ context.Context, id string, hash []byte) error {
+			fixture.requests++
+			fixture.requestID = id
+			if len(hash) != 32 {
+				t.Fatal("reupload lost content hash")
+			}
+			return nil
+		},
+	}
+	return fixture
+}
+
+func (fixture *favoriteRetryFixture) advance(t *testing.T) {
+	t.Helper()
+	if fixture.fire == nil {
+		t.Fatal("no media retry scheduled")
+	}
+	fire := fixture.fire
+	fixture.fire = nil
+	fixture.now = fixture.now.Add(fixture.delay)
+	fire()
+}
+
+func TestFavoriteRetryBackoffAndRecovery(t *testing.T) {
+	bad, good1, good2 := []byte("synthetic expired"), []byte("synthetic good 1"), []byte("synthetic good 2")
+	attempts := 0
+	recovered := false
+	fixture := newFavoriteRetryFixture(t, func(_ context.Context, msg *waE2E.StickerMessage) ([]byte, error) {
+		if bytes.Equal(msg.FileSHA256, sha256Bytes(bad)) {
+			attempts++
+			if !recovered {
+				return nil, whatsmeow.ErrMediaDownloadFailedWith403
+			}
+			return bad, nil
+		}
+		if bytes.Equal(msg.FileSHA256, sha256Bytes(good1)) {
+			return good1, nil
+		}
+		return good2, nil
+	})
+	batch := &events.FavoriteStickerSync{FromFullSync: true, Mutations: []appstate.Mutation{syntheticFavorite(bad, false), syntheticFavorite(good1, false), syntheticFavorite(good2, false)}}
+	if !fixture.wa.handleWAEvent(batch) || !fixture.wa.favoriteStickerSnapshotSeen.Load() {
+		t.Fatal("partial publication was not acknowledged")
+	}
+	if len(syntheticImages(t, fixture.matrix)) != 3 || fixture.delay != time.Minute || attempts != 1 || fixture.requests != 1 {
+		t.Fatal("incorrect first partial publication/backoff")
+	}
+	for step := 0; step < 7; step++ {
+		before := fixture.logs.String()
+		if !fixture.wa.handleWAEvent(batch) || attempts != step+1 || fixture.logs.String() != before {
+			t.Fatalf("ordinary sync retried or logged deferred media: step=%d attempts=%d before=%s after=%s", step, attempts, before, fixture.logs.String())
+		}
+		expected := min(time.Minute*time.Duration(1<<step), time.Hour)
+		if fixture.delay != expected {
+			t.Fatalf("step %d delay=%s expected=%s", step, fixture.delay, expected)
+		}
+		fixture.advance(t)
+		if attempts != step+2 || strings.Count(fixture.logs.String(), "Favorite sticker download deferred") != attempts || fixture.requests != attempts {
+			t.Fatal("failure was not logged/requested once per due attempt")
+		}
+	}
+	if fixture.delay != time.Hour {
+		t.Fatal("backoff did not cap")
+	}
+	recovered = true
+	fixture.advance(t)
+	if len(syntheticImages(t, fixture.matrix)) != 4 || len(fixture.wa.favoriteStickerRetries.pending) != 0 || fixture.fire != nil {
+		t.Fatal("media did not publish after recovery, or timer persisted")
+	}
+	if strings.Contains(fixture.logs.String(), "Failed to publish favorite stickers") {
+		t.Fatal("download failure leaked into whole-batch retry")
+	}
+}
+
+func TestFavoriteRetryRemoveAndSnapshotWin(t *testing.T) {
+	for _, scenario := range []string{"remove", "set_false", "empty_snapshot", "replacement_snapshot"} {
+		t.Run(scenario, func(t *testing.T) {
+			attempts := 0
+			fixture := newFavoriteRetryFixture(t, func(context.Context, *waE2E.StickerMessage) ([]byte, error) {
+				attempts++
+				return nil, whatsmeow.ErrMediaDownloadFailedWith403
+			})
+			mutation := syntheticFavorite([]byte("synthetic expired"), false)
+			if !fixture.wa.handleWAEvent(&events.FavoriteStickerSync{Mutations: []appstate.Mutation{mutation}}) {
+				t.Fatal("initial deferred batch failed")
+			}
+			stale := fixture.fire
+			batch := &events.FavoriteStickerSync{}
+			switch scenario {
+			case "remove":
+				mutation.Operation = waServerSync.SyncdMutation_REMOVE
+				mutation.Action = nil
+				batch.Mutations = []appstate.Mutation{mutation}
+			case "set_false":
+				mutation = cloneFavoriteMutation(mutation)
+				mutation.Action.StickerAction.IsFavorite = proto.Bool(false)
+				batch.Mutations = []appstate.Mutation{mutation}
+			case "empty_snapshot":
+				batch.FromFullSync = true
+			case "replacement_snapshot":
+				batch.FromFullSync = true
+				data := []byte("replacement synthetic")
+				batch.Mutations = []appstate.Mutation{syntheticFavorite(data, false)}
+				fixture.wa.favoriteStickerRetries.download = func(context.Context, *waE2E.StickerMessage) ([]byte, error) { attempts++; return data, nil }
+			}
+			if !fixture.wa.handleWAEvent(batch) {
+				t.Fatal("newer state failed")
+			}
+			before := attempts
+			stale()
+			if attempts != before || len(fixture.wa.favoriteStickerRetries.pending) != 0 {
+				t.Fatal("stale retry resurrected removed favorite")
+			}
+			expected := 1
+			if scenario == "replacement_snapshot" {
+				expected = 2
+			}
+			if len(syntheticImages(t, fixture.matrix)) != expected {
+				t.Fatal("snapshot/remove lost foreign or retained expired favorite")
+			}
+		})
+	}
+}
+
+func TestFavoriteRetryMatrixFailureDoesNotLoseMedia(t *testing.T) {
+	for _, scenario := range []string{"read", "upload", "put"} {

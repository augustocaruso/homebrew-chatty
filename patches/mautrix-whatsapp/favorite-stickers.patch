+
+func TestFavoriteForbiddenPreservesPublishedAndOrdersChanges(t *testing.T) {
+	for _, removeLast := range []bool{false, true} {
+		t.Run(map[bool]string{false: "set_wins", true: "remove_wins"}[removeLast], func(t *testing.T) {
+			bad, old, good := []byte("synthetic expired"), []byte("synthetic published"), []byte("synthetic good")
+			fixture := newFavoriteRetryFixture(t, func(_ context.Context, msg *waE2E.StickerMessage) ([]byte, error) {
+				if bytes.Equal(msg.FileSHA256, sha256Bytes(bad)) {
+					return nil, whatsmeow.ErrMediaDownloadFailedWith403
+				}
+				if bytes.Equal(msg.FileSHA256, sha256Bytes(old)) {
+					t.Fatal("already published media was downloaded again")
+				}
+				return good, nil
+			})
+			prefix := favoriteStickerPrefix("synthetic-login")
+			oldMutation := syntheticFavorite(old, false)
+			oldChange, _ := favoriteStickerMutation(prefix, oldMutation)
+			oldEntry := favoriteStickerEntry(oldChange, favoriteStickerMedia{Data: old, MimeType: "image/webp"}, "mxc://synthetic/existing", "")
+			fixture.matrix.content["images"], _ = json.Marshal(map[string]json.RawMessage{oldChange.Key: oldEntry, "other_client": json.RawMessage(`{"url":"mxc://synthetic/foreign"}`)})
+			set := syntheticFavorite(good, false)
+			remove := cloneFavoriteMutation(set)
+			remove.Operation = waServerSync.SyncdMutation_REMOVE
+			remove.Action = nil
+			changes := []appstate.Mutation{syntheticFavorite(bad, false), oldMutation, remove, set}
+			if removeLast {
+				changes = append(changes, remove)
+			}
+			if !fixture.wa.handleWAEvent(&events.FavoriteStickerSync{FromFullSync: true, Mutations: changes}) {
+				t.Fatal("partial snapshot failed")
+			}
+			images := syntheticImages(t, fixture.matrix)
+			goodChange, _ := favoriteStickerMutation(prefix, set)
+			if images[oldChange.Key] == nil || images["other_client"] == nil || (images[goodChange.Key] != nil) == removeLast {
+				t.Fatal("failed download lost published entries or violated last mutation order")
+			}
+		})
+	}
+}

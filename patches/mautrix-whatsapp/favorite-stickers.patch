+package connector
+
+import (
+	"context"
+	"testing"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func TestFavoriteRetryStopsAndResumesWithClient(t *testing.T) {
+	attempts := 0
+	fixture := newFavoriteRetryFixture(t, func(context.Context, *waE2E.StickerMessage) ([]byte, error) {
+		attempts++
+		return nil, whatsmeow.ErrMediaDownloadFailedWith403
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	fixture.wa.Main.Bridge.BackgroundCtx = ctx
+	batch := &events.FavoriteStickerSync{Mutations: []appstate.Mutation{syntheticFavorite([]byte("synthetic lifecycle"), false)}}
+	if !fixture.wa.handleWAEvent(batch) {
+		t.Fatal("initial defer failed")
+	}
+	stale := fixture.fire
+	fixture.wa.Disconnect()
+	stale()
+	if fixture.wa.handleWAEvent(batch) || attempts != 1 {
+		t.Fatal("disconnected client retried media")
+	}
+	fixture.wa.resumeFavoriteStickerRetries(fixture.wa.Main.Bridge.BackgroundCtx)
+	fixture.advance(t)
+	if attempts != 2 || len(fixture.wa.favoriteStickerRetries.pending) != 1 {
+		t.Fatal("reconnect lost pending retry")
+	}
+	cancel()
+	stale = fixture.fire
+	stale()
+	if attempts != 2 || fixture.wa.handleFavoriteStickerSync(ctx, batch) {
+		t.Fatal("canceled context retried or acknowledged media")
+	}
+}

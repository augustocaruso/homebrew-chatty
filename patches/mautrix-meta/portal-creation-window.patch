+func (ic *IGClient) shouldCreatePortalForBackfill(thread *slidetypes.ThreadInfo) bool {
+	backfillSince := ic.Main.Config.backfillSince
+	if backfillSince.IsZero() || !thread.LastActivityTimestampMS.Before(backfillSince) {
+		return true
+	}
+	if thread.SlideMessages != nil {
+		for _, edge := range thread.SlideMessages.Edges {
+			if edge.Node != nil && !edge.Node.TimestampMS.Before(backfillSince) {
+				return true
+			}
+		}
+	}
+	return false
+}

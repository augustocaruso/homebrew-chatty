diff --git a/pkg/igconnector/ghost_profile_update_test.go b/pkg/igconnector/ghost_profile_update_test.go
new file mode 100644
index 0000000..196f849
--- /dev/null
+++ b/pkg/igconnector/ghost_profile_update_test.go
@@ -0,0 +1,32 @@
+package igconnector
+
+import (
+	"testing"
+
+	"go.mau.fi/mautrix-meta/pkg/instameow/slidetypes"
+)
+
+func TestWrapUserInfoLeavesNameUnsetWithoutIdentity(t *testing.T) {
+	config := Config{DisplaynameTemplate: "{{.DisplayName}}"}
+	if err := config.PostProcess(); err != nil {
+		t.Fatalf("failed to configure test client: %v", err)
+	}
+	client := &IGClient{Main: &IGConnector{Config: config}}
+
+	empty := client.wrapUserInfo(&slidetypes.User{})
+	if empty.Name != nil {
+		t.Fatalf("empty profile name = %q, want nil", *empty.Name)
+	}
+
+	named := client.wrapUserInfo(&slidetypes.User{FullName: "Known person"})
+	if named.Name == nil || *named.Name != "Known person" {
+		t.Fatalf("named profile name = %v, want Known person", named.Name)
+	}
+}
+
+func TestUpdateGhostFromEventSkipsEmptyIdentity(t *testing.T) {
+	client := &IGClient{}
+	sender := &slidetypes.MessageSender{UserDict: slidetypes.User{InteropMessagingUserFBID: 1}}
+
+	client.updateGhostFromEvent(sender)
+}

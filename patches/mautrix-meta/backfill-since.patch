+// filterBackfillMessages returns the newest prefix within the optional time window.
+// Instagram pages are ordered newest to oldest, so the first older message ends pagination.
+func filterBackfillMessages(messages []slidetypes.Node[*slidetypes.Message], backfillSince time.Time) ([]slidetypes.Node[*slidetypes.Message], bool) {
+	if backfillSince.IsZero() {
+		return messages, false
+	}
+	for i, msg := range messages {
+		if msg.Node != nil && msg.Node.TimestampMS.Before(backfillSince) {
+			return messages[:i], true
+		}
+	}
+	return messages, false
+}

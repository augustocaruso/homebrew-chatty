diff --git a/pkg/igconnector/backfill_since_test.go b/pkg/igconnector/backfill_since_test.go
new file mode 100644
index 0000000..f748ba6
--- /dev/null
+++ b/pkg/igconnector/backfill_since_test.go
@@ -0,0 +1,154 @@
+package igconnector
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/util/jsontime"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/bridgeconfig"
+	bridgedb "maunium.net/go/mautrix/bridgev2/database"
+
+	"go.mau.fi/mautrix-meta/pkg/instameow"
+	"go.mau.fi/mautrix-meta/pkg/instameow/slidetypes"
+	"go.mau.fi/mautrix-meta/pkg/messagix/cookies"
+	"go.mau.fi/mautrix-meta/pkg/messagix/types"
+	"go.mau.fi/mautrix-meta/pkg/metaid"
+)
+
+type backfillRoundTripper func(*http.Request) (*http.Response, error)
+
+func (fn backfillRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	return fn(req)
+}
+
+func newBackfillTestClient(since time.Time) *IGClient {
+	testCookies := &cookies.Cookies{Platform: types.Instagram}
+	testCookies.UpdateValues(map[cookies.MetaCookieName]string{})
+	return &IGClient{
+		Main: &IGConnector{
+			Bridge: &bridgev2.Bridge{Config: &bridgeconfig.BridgeConfig{}},
+			Config: Config{backfillSince: since},
+		},
+		Client: instameow.NewClient(instameow.ClientParams{
+			Cookies: testCookies,
+			Log:     zerolog.Nop(),
+		}),
+	}
+}
+
+func backfillMessage(id string, timestamp time.Time) slidetypes.Node[*slidetypes.Message] {
+	return slidetypes.Node[*slidetypes.Message]{
+		Node: &slidetypes.Message{
+			ID:          id,
+			TimestampMS: jsontime.UnixMilliString{Time: timestamp},
+		},
+	}
+}
+
+func backfillTestPortal() *bridgev2.Portal {
+	return &bridgev2.Portal{Portal: &bridgedb.Portal{}}
+}
+
+func TestFilterBackfillMessagesIncludesBoundaryAndStopsAtOlderMessage(t *testing.T) {
+	cutoff := time.Date(2024, 9, 10, 3, 0, 0, 0, time.UTC)
+	messages := []slidetypes.Node[*slidetypes.Message]{
+		backfillMessage("newer", cutoff.Add(time.Millisecond)),
+		backfillMessage("boundary", cutoff),
+		backfillMessage("older", cutoff.Add(-time.Millisecond)),
+	}
+
+	filtered, reached := filterBackfillMessages(messages, cutoff)
+	if !reached {
+		t.Fatal("expected the older message to stop pagination")
+	}
+	if len(filtered) != 2 || filtered[0].Node.ID != "newer" || filtered[1].Node.ID != "boundary" {
+		t.Fatalf("unexpected messages inside the time window: %#v", filtered)
+	}
+}
+
+func TestFilterBackfillMessagesWithoutWindowPreservesBaseline(t *testing.T) {
+	messages := []slidetypes.Node[*slidetypes.Message]{
+		backfillMessage("newer", time.Now()),
+		backfillMessage("older", time.Time{}),
+	}
+
+	filtered, reached := filterBackfillMessages(messages, time.Time{})
+	if reached || len(filtered) != len(messages) || filtered[0].Node.ID != "newer" || filtered[1].Node.ID != "older" {
+		t.Fatalf("empty backfill_since changed the baseline: reached=%t messages=%#v", reached, filtered)
+	}
+}
+
+func TestForwardBackfillStopsAtWindowBeforeConversion(t *testing.T) {
+	cutoff := time.Date(2024, 9, 10, 3, 0, 0, 0, time.UTC)
+	ic := newBackfillTestClient(cutoff)
+	thread := &slidetypes.ThreadInfo{SlideMessages: &slidetypes.SlideMessages{
+		Edges:    []slidetypes.Node[*slidetypes.Message]{backfillMessage("older", cutoff.Add(-time.Millisecond))},
+		PageInfo: slidetypes.PageInfo{HasNextPage: true},
+	}}
+
+	resp, err := ic.fetchForwardBackfill(context.Background(), bridgev2.FetchMessagesParams{
+		Forward:     true,
+		Count:       20,
+		BundledData: thread,
+		Portal:      backfillTestPortal(),
+	}, &metaid.PortalMetadata{})
+	if err != nil {
+		t.Fatalf("forward backfill failed: %v", err)
+	}
+	if len(resp.Messages) != 0 {
+		t.Fatalf("expected no converted messages before backfill_since, got %d", len(resp.Messages))
+	}
+}
+
+func TestForwardInitialBackfillErrorsWhenLimitPrecedesWindow(t *testing.T) {
+	cutoff := time.Date(2024, 9, 10, 3, 0, 0, 0, time.UTC)
+	ic := newBackfillTestClient(cutoff)
+	thread := &slidetypes.ThreadInfo{SlideMessages: &slidetypes.SlideMessages{
+		Edges:    []slidetypes.Node[*slidetypes.Message]{backfillMessage("newer", cutoff.Add(time.Millisecond))},
+		PageInfo: slidetypes.PageInfo{HasNextPage: true},
+	}}
+
+	_, err := ic.fetchForwardBackfill(context.Background(), bridgev2.FetchMessagesParams{
+		Forward:     true,
+		Count:       1,
+		BundledData: thread,
+	}, &metaid.PortalMetadata{})
+	if err == nil || !strings.Contains(err.Error(), "reached before backfill_since") {
+		t.Fatalf("expected explicit incomplete-window error, got %v", err)
+	}
+}
+
+func TestBackwardBackfillStopsPaginationAtWindowBeforeConversion(t *testing.T) {
+	cutoff := time.Date(2024, 9, 10, 3, 0, 0, 0, time.UTC)
+	ic := newBackfillTestClient(cutoff)
+	requestCount := 0
+	ic.Client.GetHTTP().HTTP.Transport = backfillRoundTripper(func(req *http.Request) (*http.Response, error) {
+		requestCount++
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader(`{"data":{"fetch__SlideThread":{"as_ig_direct_thread":{"id":"synthetic-thread","slide_messages":{"edges":[{"node":{"id":"older","timestamp_ms":"1725937199999"}}],"page_info":{"end_cursor":"next-page","has_next_page":true}}}}}}`)),
+			Request:    req,
+		}, nil
+	})
+
+	resp, err := ic.fetchBackwardBackfill(context.Background(), bridgev2.FetchMessagesParams{
+		Count:  20,
+		Cursor: BackfillCursorPrefix + "first-page",
+	}, &metaid.PortalMetadata{IGID: "synthetic-thread"})
+	if err != nil {
+		t.Fatalf("backward backfill failed: %v", err)
+	}
+	if requestCount != 1 {
+		t.Fatalf("expected one native pagination request before cutoff, got %d", requestCount)
+	}
+	if len(resp.Messages) != 0 || resp.HasMore {
+		t.Fatalf("expected cutoff to return no messages and stop pagination, got messages=%d has_more=%t", len(resp.Messages), resp.HasMore)
+	}
+}

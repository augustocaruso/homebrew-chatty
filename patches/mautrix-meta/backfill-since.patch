index 0000000..eb338e5
--- /dev/null
+++ b/pkg/igconnector/config_backfill_since_test.go
@@ -0,0 +1,39 @@
+package igconnector
+
+import (
+	"testing"
+	"time"
+
+	"gopkg.in/yaml.v3"
+)
+
+func TestConfigRejectsInvalidBackfillSince(t *testing.T) {
+	var cfg Config
+	err := yaml.Unmarshal([]byte("backfill_since: not-a-rfc3339-timestamp\n"), &cfg)
+	if err == nil {
+		t.Fatal("expected invalid backfill_since to be rejected")
+	}
+}
+
+func TestConfigParsesOptionalBackfillSince(t *testing.T) {
+	const configured = "2024-09-10T00:00:00-03:00"
+	var cfg Config
+	if err := yaml.Unmarshal([]byte("backfill_since: "+configured+"\n"), &cfg); err != nil {
+		t.Fatalf("failed to parse valid backfill_since: %v", err)
+	}
+	if cfg.BackfillSince != configured {
+		t.Fatalf("backfill_since changed during parsing: %q", cfg.BackfillSince)
+	}
+	expected, _ := time.Parse(time.RFC3339, configured)
+	if !cfg.backfillSince.Equal(expected) {
+		t.Fatalf("parsed cutoff = %s, want %s", cfg.backfillSince, expected)
+	}
+
+	var omitted Config
+	if err := yaml.Unmarshal([]byte("disable_typing: true\n"), &omitted); err != nil {
+		t.Fatalf("failed to parse config without backfill_since: %v", err)
+	}
+	if !omitted.backfillSince.IsZero() {
+		t.Fatalf("omitted backfill_since should preserve baseline, got %s", omitted.backfillSince)
+	}
+}
